---
const annee = 2027;
---

<footer class="pied">
  <div class="pied__grille">
    <div class="pied__marque">
      <img src="/brouillon/logo-petit.webp" alt="Les Ragondins Farfelus" width="564" height="338" />
      <p>
        Festival de musique et de magie<br />
        Domaine de Briquemault, Sainte-Geneviève-des-Bois (Loiret)
      </p>
    </div>

    <nav aria-label="Liens du pied de page">
      <h2 class="pied__titre">Le festival</h2>
      <ul>
        <li><a href="#programme">Programme</a></li>
        <li><a href="#billetterie">Billetterie</a></li>
        <li><a href="#benevoles">Devenir bénévole</a></li>
        <li><a href="#lieu">Venir au festival</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="pied__titre">Ensemble</h2>
      <ul>
        <li><a href="#solidarite">Handi'Chiens</a></li>
        <li><a href="https://domainedebriquemault.com" rel="noopener">Domaine de Briquemault</a></li>
        <li><a href="#">Mentions légales</a></li>
      </ul>
    </div>
  </div>

  <p class="pied__bas">
    © {annee} Les Ragondins Farfelus · Festival au profit de l'association Handi'Chiens
  </p>
</footer>

<style>
  .pied {
    background: var(--vert-nuit);
    border-top: 1px solid rgba(243, 226, 176, 0.18);
    padding: 4rem var(--marge) 2rem;
    color: var(--creme-doux);
    font-size: 0.975rem;
  }

  .pied__grille {
    max-width: var(--largeur-max);
    margin: 0 auto;
    display: grid;
    gap: 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }

  .pied__marque img {
    width: 11rem;
    margin-bottom: 1rem;
  }

  .pied__titre {
    font-family: var(--font-texte);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--rose);
    margin-bottom: 1rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  a {
    color: var(--creme);
    text-decoration: none;
  }

  a:hover {
    color: var(--rose);
    text-decoration: underline;
  }

  .pied__bas {
    max-width: var(--largeur-max);
    margin: 3rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(243, 226, 176, 0.12);
    font-size: 0.875rem;
  }
</style>
