---
import { liensExternes } from "../data/site";

// Tant que l'outil de newsletter n'est pas choisi, le formulaire est affiché
// mais désactivé, avec une mention claire.
const actif = Boolean(liensExternes.newsletter);
---

<section class="newsletter" aria-labelledby="titre-newsletter">
  <div class="newsletter__contenu">
    <div>
      <h2 id="titre-newsletter">Ne manquez pas l'ouverture du portail</h2>
      <p>
        Programmation, ouverture de la billetterie, surprises : recevez les nouvelles du monde des
        Ragondins en premier.
      </p>
    </div>
    <form class="newsletter__form" action={actif ? liensExternes.newsletter : undefined} method="post">
      <label for="newsletter-email">Votre adresse e-mail</label>
      <div class="newsletter__ligne">
        <input
          id="newsletter-email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="prenom@exemple.fr"
          required
          disabled={!actif}
        />
        <button class="bouton bouton--rose" type="submit" disabled={!actif}>
          {actif ? "Je m'inscris" : "Bientôt disponible"}
        </button>
      </div>
      <p class="newsletter__note">
        Un e-mail de temps en temps, jamais de spam. Désinscription en un clic.&#32;
        <a href="/confidentialite/">Confidentialité</a>
      </p>
    </form>
  </div>
</section>

<style>
  .newsletter {
    background:
      radial-gradient(ellipse 50% 120% at 0% 50%, rgba(255, 160, 203, 0.16), transparent 70%),
      var(--vert);
    border-top: 1px solid rgba(243, 226, 176, 0.15);
    padding: clamp(3rem, 7vw, 4.5rem) var(--marge);
  }

  .newsletter__contenu {
    max-width: var(--largeur-max);
    margin: 0 auto;
    display: grid;
    gap: 2rem 4rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    align-items: center;
  }

  h2 {
    font-size: clamp(1.7rem, 4vw, 2.4rem);
  }

  .newsletter__contenu > div p {
    margin: 0;
    color: var(--creme-doux);
  }

  label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .newsletter__ligne {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  input {
    flex: 1 1 14rem;
    min-width: 0;
    min-height: 3rem;
    padding: 0.75rem 1.1rem;
    border-radius: 999px;
    border: 1.5px solid rgba(243, 226, 176, 0.5);
    background: rgba(5, 40, 40, 0.6);
    color: var(--creme);
    font: inherit;
  }

  input::placeholder {
    color: rgba(230, 223, 198, 0.6);
  }

  button[disabled],
  input[disabled] {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .newsletter__note {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    color: var(--creme-doux);
  }
</style>
