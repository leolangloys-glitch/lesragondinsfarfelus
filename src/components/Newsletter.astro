---
import { liensExternes } from "../data/site";

// Inscription à la newsletter. L'adresse du formulaire de l'outil d'envoi
// (Brevo conseillé) se renseigne dans l'administration (/admin/, « Réglages »).
// Tant qu'elle est vide, le formulaire est affiché mais désactivé.
const actif = Boolean(liensExternes.newsletter);
// Les formulaires Brevo attendent le champ « EMAIL » et deux champs cachés
const brevo = /sibforms\.com/.test(liensExternes.newsletter);
---

<section class="newsletter" aria-labelledby="titre-newsletter">
  <div class="newsletter__contenu">
    <div>
      <h2 id="titre-newsletter">Ne manquez pas l'ouverture du portail</h2>
      <p>
        Programmation, ouverture de la billetterie, surprises : recevez les nouvelles du monde des
        Ragondins en premier.
      </p>
    </div>
    <form class="newsletter__form" action={actif ? liensExternes.newsletter : undefined} method="post" data-brevo={brevo ? "" : undefined}>
      {brevo && <input type="text" name="email_address_check" value="" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />}
      {brevo && <input type="hidden" name="locale" value="fr" />}
      <label for="newsletter-email">Votre adresse e-mail</label>
      <div class="newsletter__ligne">
        <input
          id="newsletter-email"
          name={brevo ? "EMAIL" : "email"}
          type="email"
          autocomplete="email"
          placeholder="prenom@exemple.fr"
          required
          disabled={!actif}
        />
        <button class="bouton bouton--rose" type="submit" disabled={!actif}>
          {actif ? "Je m'inscris" : "Bientôt disponible"}
        </button>
      </div>
      <p class="newsletter__note">
        Un e-mail de temps en temps, jamais de spam. Désinscription en un clic.&#32;
        <a href="/confidentialite/">Confidentialité</a> · <a href="/lettres/">Les lettres précédentes</a>
      </p>
      <p class="newsletter__merci" role="status" hidden>
        Merci&nbsp;! Pour confirmer votre inscription, cliquez sur le lien dans l'e-mail que vous
        allez recevoir.
      </p>
    </form>
  </div>
</section>

<script>
  // Inscription Brevo sans quitter la page (sinon, envoi classique du formulaire)
  document.querySelectorAll<HTMLFormElement>(".newsletter__form[data-brevo]").forEach((form) => {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const merci = form.querySelector<HTMLElement>(".newsletter__merci");
      try {
        await fetch(form.action, { method: "POST", body: new FormData(form), mode: "no-cors" });
        form.reset();
        if (merci) merci.hidden = false;
      } catch {
        form.submit();
      }
    });
  });
</script>

<style>
  .newsletter {
    background:
      radial-gradient(ellipse 50% 120% at 0% 50%, rgba(255, 160, 203, 0.16), transparent 70%),
      var(--vert);
    border-top: 1px solid rgba(243, 226, 176, 0.15);
    padding: clamp(3rem, 7vw, 4.5rem) var(--marge);
  }

  .newsletter__contenu {
    max-width: var(--largeur-max);
    margin: 0 auto;
    display: grid;
    gap: 2rem 4rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    align-items: center;
  }

  h2 {
    font-size: clamp(1.7rem, 4vw, 2.4rem);
  }

  .newsletter__contenu > div p {
    margin: 0;
    color: var(--creme-doux);
  }

  label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .newsletter__ligne {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  input {
    flex: 1 1 14rem;
    min-width: 0;
    min-height: 3rem;
    padding: 0.75rem 1.1rem;
    border-radius: 999px;
    border: 1.5px solid rgba(243, 226, 176, 0.5);
    background: rgba(5, 40, 40, 0.6);
    color: var(--creme);
    font: inherit;
  }

  input::placeholder {
    color: rgba(230, 223, 198, 0.6);
  }

  button[disabled],
  input[disabled] {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .newsletter__note {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    color: var(--creme-doux);
  }

  .newsletter__merci {
    margin: 0.75rem 0 0;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    border: 1.5px solid var(--rose);
  }
</style>
