---
// Vidéo YouTube chargée seulement au clic (pas de cookie YouTube avant :
// respect de la vie privée et page plus légère). Sans lien : « bientôt ».
import { idYouTube } from "../lib/medias";

interface Props {
  lien?: string;
  titre: string;
  bientot?: string;
}

const { lien, titre, bientot = "Bientôt disponible" } = Astro.props;
const id = idYouTube(lien);
---

{
  id ? (
    <div class="video" data-video={id}>
      <button class="video__lancer" type="button" aria-label={`Lancer la vidéo : ${titre}`}>
        <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
        <span class="video__icone" aria-hidden="true" />
      </button>
      <p class="video__note">La vidéo est hébergée par YouTube, qui peut déposer des cookies quand vous la lancez.</p>
    </div>
  ) : (
    <div class="video video--bientot">
      <p>
        <span class="video__titre">{titre}</span>
        <span>{bientot}</span>
      </p>
    </div>
  )
}

<script>
  document.querySelectorAll<HTMLElement>(".video[data-video]").forEach((bloc) => {
    bloc.querySelector("button")?.addEventListener("click", () => {
      const cadre = document.createElement("iframe");
      cadre.src = `https://www.youtube-nocookie.com/embed/${bloc.dataset.video}?autoplay=1&rel=0`;
      cadre.title = bloc.querySelector("button")?.getAttribute("aria-label")?.replace("Lancer la vidéo : ", "") ?? "Vidéo";
      cadre.allow = "accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen";
      cadre.allowFullscreen = true;
      bloc.replaceChildren(cadre);
    });
  });
</script>

<style>
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--rayon);
    overflow: hidden;
    border: 1.5px solid rgba(243, 226, 176, 0.45);
    background: var(--vert-nuit);
  }

  .video :global(iframe),
  .video__lancer,
  .video__lancer img {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video__lancer {
    position: relative;
    padding: 0;
    background: #000;
    cursor: pointer;
  }

  .video__lancer img {
    object-fit: cover;
    opacity: 0.85;
  }

  .video__icone {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 4.5rem;
    height: 4.5rem;
    margin: -2.25rem 0 0 -2.25rem;
    border-radius: 50%;
    background: var(--rose);
    box-shadow: 0 0 2rem rgba(255, 160, 203, 0.5);
  }

  .video__icone::after {
    content: "";
    position: absolute;
    left: 54%;
    top: 50%;
    transform: translate(-50%, -50%);
    border-left: 1.2rem solid var(--vert);
    border-top: 0.75rem solid transparent;
    border-bottom: 0.75rem solid transparent;
  }

  .video__lancer:hover .video__icone,
  .video__lancer:focus-visible .video__icone {
    transform: scale(1.08);
  }

  .video__note {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0.4rem 0.8rem;
    font-size: 0.75rem;
    color: var(--creme-doux);
    background: linear-gradient(to top, rgba(0, 0, 0, 0.75), transparent);
    pointer-events: none;
  }

  .video--bientot {
    display: grid;
    place-items: center;
    text-align: center;
    background:
      radial-gradient(ellipse at 50% 40%, rgba(44, 122, 111, 0.6), transparent 70%),
      var(--vert-nuit);
  }

  .video--bientot p {
    margin: 0;
    display: grid;
    gap: 0.35rem;
    padding: 1rem;
  }

  .video__titre {
    font-family: var(--font-titre);
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    color: var(--creme);
  }
</style>
