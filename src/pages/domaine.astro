---
import Base from "../layouts/Base.astro";
import EnTetePage from "../components/EnTetePage.astro";
import { festival, lieuSchema } from "../data/site";

// Les lieux du domaine (photos : Domaine de Briquemault, reprises de son site
// à la demande de l'équipe, novembre 2026). Textes écrits pour le festival.
const lieux = [
  {
    nom: "La Forteresse & les Douves",
    photo: "/medias/domaine/forteresse-nuit.webp",
    alt: "Les tours du château fort illuminées la nuit, reflétées dans les douves",
    texte: "Les vestiges du château fort médiéval, cernés de douves. En 2027, ils s'illuminent à la nuit tombée, avec une scène sur pilotis à leur pied.",
    nouveau: true,
  },
  {
    nom: "Le Manoir",
    photo: "/medias/domaine/manoir.webp",
    alt: "Le manoir du domaine au bout d'une allée de gravier, entre les grands arbres",
    texte: "Le cœur du domaine. À la nuit tombée, sa façade peut s'animer de projections lumineuses.",
  },
  {
    nom: "L'Orangerie de Cristal",
    photo: "/medias/domaine/orangerie.webp",
    alt: "La grande verrière de l'Orangerie de Cristal sur la pelouse",
    texte: "Une verrière de 400 m² face au manoir, baignée de lumière le jour et scintillante la nuit.",
  },
  {
    nom: "Le Théâtre de Verdure",
    photo: "/medias/domaine/theatre-verdure.webp",
    alt: "Les bâtiments du domaine au bord de l'eau, au crépuscule",
    texte: "Un amphithéâtre végétal à ciel ouvert, au cœur du parc, fait pour les concerts.",
  },
  {
    nom: "La Tente Bambou",
    photo: "/medias/domaine/tente-bambou.webp",
    alt: "Une grande tente ouverte, décorée de guirlandes lumineuses, au crépuscule",
    texte: "Une grande tente ouverte sur la nature, pour rester à l'abri quoi qu'annonce le ciel.",
  },
  {
    nom: "L'Espace Guinguette",
    photo: "/medias/domaine/guinguette.webp",
    alt: "La salle de la guinguette, ses poutres et ses grandes portes vitrées",
    texte: "Le coin convivial du domaine, grand ouvert sur le parc.",
  },
  {
    nom: "La Cascade",
    photo: "/medias/domaine/cascade.webp",
    alt: "Une cascade naturelle entre les arbres",
    texte: "Une cascade naturelle qui chante au creux du parc.",
  },
  {
    nom: "Le Parc",
    photo: "/medias/domaine/parc.webp",
    alt: "Les prairies et les arbres du parc, avec l'orangerie au loin",
    texte: "Dix hectares d'arbres centenaires, de prairies et de cours d'eau, au bord du Loing.",
  },
];
---

<Base
  titre="Le Domaine de Briquemault (Loiret)"
  nomCourt="Le Domaine de Briquemault"
  description="Le Domaine de Briquemault, 10 hectares de nature et d'histoire entre Montargis et Gien (Loiret), accueille le festival Les Ragondins Farfelus."
  donneesStructurees={{ "@context": "https://schema.org", ...lieuSchema() }}
>
  <EnTetePage
    surtitre="Le lieu"
    titre="Le Domaine de Briquemault"
    intro="À 1 h 30 de Paris et 1 h 15 d'Orléans, entre Montargis et Gien, un domaine chargé d'histoire qui se transforme chaque printemps en monde des Ragondins Farfelus."
  >
    <div class="boutons">
      <a class="bouton bouton--rose" href={festival.lieu.site} rel="noopener">Visiter le site du domaine</a>
    </div>
  </EnTetePage>

  <figure class="panorama">
    <img
      src="/medias/domaine/panorama.webp"
      alt="Vue d'ensemble du domaine : la prairie, le manoir et ses dépendances sous les arbres"
      width="2000"
      height="924"
      fetchpriority="high"
    />
  </figure>

  <section class="section fond-nuit" aria-labelledby="titre-histoire">
    <div class="contenu deux-colonnes">
      <div>
        <span class="surtitre">Huit siècles d'histoire</span>
        <h2 id="titre-histoire">Une forteresse devenue terre de fête</h2>
        <figure class="histoire__photo">
          <img
            src="/medias/domaine/forteresse-jour.webp"
            alt="Les deux tours rondes du château fort se reflètent dans les douves"
            width="900"
            height="1200"
            loading="lazy"
          />
        </figure>
      </div>
      <div>
        <p class="intro">
          Attesté dès 1240, le site de Briquemault a traversé les siècles. Entièrement rénové et
          rouvert au printemps 2026, le domaine s'étend sur dix hectares de nature préservée.
        </p>
        <p class="texte-doux">
          Les deux grosses tours rondes du château fort se reflètent dans les douves couvertes de
          nénuphars, entre lavande et peupliers. Ruines, orangerie, guinguette, prairies et bords du
          Loing&nbsp;: un décor idéal pour accueillir un monde magique le temps d'un week-end.
        </p>
        <p class="texte-doux">
          <strong>Nouveauté 2027&nbsp;:</strong> le château fort sera illuminé à la nuit tombée, avec
          une scène sur pilotis au pied de ses tours.
        </p>
      </div>
    </div>
  </section>

  <section class="section fond-vert" aria-labelledby="titre-chiffres">
    <div class="contenu">
      <h2 id="titre-chiffres" class="sr-only">Le domaine en chiffres</h2>
      <dl class="chiffres">
        <div><dt>Hectares de nature</dt><dd class="texte-or">10</dd></div>
        <div><dt>De Paris</dt><dd class="texte-or">1 h 30</dd></div>
        <div><dt>Première mention du site</dt><dd class="texte-or">1240</dd></div>
      </dl>
    </div>
  </section>

  <section class="section fond-nuit" id="lieux" aria-labelledby="titre-lieux">
    <div class="contenu">
      <div class="titre-section">
        <span class="surtitre">Les lieux</span>
        <h2 id="titre-lieux">Un domaine, mille décors</h2>
        <p class="intro">
          Forteresse, manoir, orangerie, théâtre de verdure, cascade&nbsp;: tour d'horizon du monde
          qui accueille les Ragondins Farfelus.
        </p>
      </div>
      <ul class="lieux">
        {
          lieux.map((l) => (
            <li class:list={["lieu", { "lieu--nouveau": l.nouveau }]}>
              <img src={l.photo} alt={l.alt} loading="lazy" decoding="async" width="1000" height="667" />
              <div class="lieu__texte">
                {l.nouveau && <span class="lieu__badge">Nouveauté 2027</span>}
                <h3>{l.nom}</h3>
                <p>{l.texte}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="credit">Photos&nbsp;: Domaine de Briquemault.</p>
    </div>
  </section>

  <section class="section fond-vert" aria-labelledby="titre-annee">
    <div class="contenu">
      <div class="titre-section">
        <span class="surtitre">Toute l'année</span>
        <h2 id="titre-annee">Le domaine, au-delà du festival</h2>
        <p class="intro">Le reste de l'année, le Domaine de Briquemault accueille&nbsp;:</p>
      </div>
      <div class="grille">
        <article class="carte"><h3>Mariages</h3><p class="texte-doux">Des réceptions dans un cadre d'exception.</p></article>
        <article class="carte"><h3>Événements d'entreprise</h3><p class="texte-doux">Séminaires, soirées et séjours d'équipe.</p></article>
        <article class="carte"><h3>Chambres d'hôtes</h3><p class="texte-doux">Pour prolonger le séjour, au festival comme toute l'année.</p></article>
        <article class="carte"><h3>Dîners-spectacles</h3><p class="texte-doux">Gastronomie et magie à la même table.</p></article>
      </div>
      <div class="boutons">
        <a class="bouton bouton--contour" href={festival.lieu.site} rel="noopener">Découvrir le Domaine de Briquemault</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .panorama {
    margin: 0;
  }

  .panorama img {
    display: block;
    width: 100%;
    height: clamp(14rem, 42vw, 34rem);
    object-fit: cover;
  }

  .histoire__photo {
    margin: 2rem 0 0;
    max-width: 22rem;
  }

  .histoire__photo img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 999px 999px var(--rayon) var(--rayon);
    border: 2px solid var(--or);
  }

  .lieux {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
  }

  .lieu {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--rayon);
    border: 1.5px solid rgba(243, 226, 176, 0.3);
    background: rgba(5, 40, 40, 0.55);
  }

  .lieu img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .lieu__texte {
    padding: 1.1rem 1.25rem 1.35rem;
  }

  .lieu h3 {
    margin: 0 0 0.4rem;
    font-size: 1.3rem;
  }

  .lieu p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--creme-doux);
  }

  /* La forteresse illuminée, nouveauté 2027 : en grand */
  .lieu--nouveau {
    grid-column: 1 / -1;
    border: 2px solid var(--or);
  }

  @media (min-width: 48rem) {
    .lieu--nouveau {
      display: grid;
      grid-template-columns: 1.6fr 1fr;
      align-items: center;
    }

    .lieu--nouveau img {
      height: 100%;
      aspect-ratio: auto;
      min-height: 18rem;
    }

    .lieu--nouveau .lieu__texte {
      padding: 2rem;
    }

    .lieu--nouveau h3 {
      font-size: 1.8rem;
    }

    .lieu--nouveau p {
      font-size: 1.05rem;
    }
  }

  .lieu__badge {
    display: inline-block;
    margin-bottom: 0.6rem;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    background: var(--rose);
    color: var(--vert);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .credit {
    margin: 1.25rem 0 0;
    font-size: 0.85rem;
    color: var(--creme-doux);
  }

  .deux-colonnes {
    display: grid;
    gap: 1.5rem 4rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .chiffres {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1.5rem;
    margin: 0;
  }

  .chiffres div {
    display: flex;
    flex-direction: column-reverse;
    border-left: 2px solid var(--rose);
    padding-left: 1.25rem;
  }

  .chiffres dt {
    color: var(--creme-doux);
  }

  .chiffres dd {
    margin: 0;
    font-family: var(--font-titre);
    font-size: clamp(2.6rem, 6vw, 3.8rem);
    font-weight: 600;
    line-height: 1.1;
  }
</style>
