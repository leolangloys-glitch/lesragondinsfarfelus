---
import Base from "../layouts/Base.astro";
import EnTetePage from "../components/EnTetePage.astro";
import ModuleExterne from "../components/ModuleExterne.astro";
import Faq from "../components/Faq.astro";
import { faqSchema, liensExternes } from "../data/site";

// Formules provisoires : contenus et tarifs à valider par l'équipe.
// Les chiffres viennent du programme 2027 donné par l'équipe (novembre 2026).
const jours = [
  {
    id: "vendredi",
    nom: "Pass vendredi",
    ambiance: "L'éveil",
    date: "Vendredi 28 mai",
    ruban: "La soirée d'ouverture",
    accroche:
      "Le portail s'ouvre et tout le domaine se réveille d'un coup. Premiers concerts au coucher du soleil, des magiciens qui surgissent là où on ne les attend pas, puis les DJ font monter la température jusqu'au bout de la nuit.",
    points: [
      "6 groupes, artistes et DJ",
      "3 à 4 magiciens, sur scène et au milieu de la foule",
      "DJ sets jusque tard dans la nuit",
      "Des surprises dès le premier soir",
    ],
    pourQui: "Pour démarrer fort",
  },
  {
    id: "samedi",
    nom: "Pass samedi",
    ambiance: "La grande nuit",
    date: "Samedi 29 mai",
    ruban: "La nuit des têtes d'affiche",
    accroche:
      "Une journée entière à fond : des concerts du jour jusqu'à la nuit, de la magie sur scène et à quelques centimètres de vous, puis la grande soirée avec les têtes d'affiche. Et quelques surprises… qu'on garde secrètes.",
    points: [
      "13 groupes, artistes et DJ",
      "5 à 6 magiciens, sur scène et en close-up",
      "La grande soirée têtes d'affiche",
      "Des surprises qu'on ne dévoile pas ici",
    ],
    pourQui: "Pour la nuit la plus folle",
  },
  {
    id: "dimanche",
    nom: "Pass dimanche",
    ambiance: "Le grand final",
    date: "Dimanche 30 mai",
    ruban: "Le grand final",
    accroche:
      "On ne quitte pas le monde des Ragondins sans un dernier tour : de la musique toute la journée, de la magie à chaque coin du domaine et des surprises jusqu'à la dernière minute. Les plus jeunes sont aussi de la fête.",
    points: [
      "5 groupes, artistes et DJ",
      "5 magiciens, dont des spectacles pour les enfants",
      "Des surprises pour finir en beauté",
      "Gratuit pour les moins de 11 ans",
    ],
    pourQui: "Entre amis ou en famille",
  },
];

const pass3jours = {
  points: [
    "Les 3 jours, de la soirée d'ouverture au grand final",
    "24 groupes, artistes et DJ et 13 à 15 magiciens",
    "Le camping au cœur du domaine, dès le vendredi après-midi",
    "Nouveauté 2027 : la forteresse illuminée et sa scène sur pilotis",
    "Toutes les surprises des trois jours (et il y en aura)",
  ],
};

// Inclus quel que soit le pass
const inclus = [
  { titre: "Les deux plateaux", texte: "La musique et la magie, sans supplément." },
  { titre: "Des surprises partout", texte: "Des magiciens au milieu de la foule, et d'autres secrets." },
  { titre: "Le camping", texte: "Possible avec tous les pass : 1, 2 ou 3 jours." },
  { titre: "Le concours de costume", texte: "Venez déguisés : les plus créatifs seront choisis." },
];

// Bouton des cartes : réserver si la billetterie est ouverte, sinon être prévenu
const billetterieOuverte = Boolean(liensExternes.billetterie);
const lienBouton = billetterieOuverte ? liensExternes.billetterie : "#titre-newsletter";
const texteBouton = billetterieOuverte ? "Réserver ce pass" : "Être prévenu de l'ouverture";

const questions = [
  {
    q: "Peut-on camper avec un pass 1 jour ?",
    r: "Oui : le camping est possible avec tous les pass, que vous veniez 1, 2 ou 3 jours. Il ouvre le vendredi après-midi, au cœur du domaine.",
  },
  {
    q: "Où acheter mes billets ?",
    r: "Uniquement sur ce site, via notre billetterie officielle. Méfiez-vous des reventes sur les réseaux sociaux ou les sites non officiels : nous ne pourrons pas garantir l'accès avec un billet acheté ailleurs.",
  },
  {
    q: "Les enfants paient-ils ?",
    r: "L'entrée est gratuite pour les moins de 11 ans. Le dimanche est spécialement pensé pour les familles.",
  },
  {
    q: "L'entrée est-elle gratuite pour les personnes en situation de handicap ?",
    r: "Oui, l'entrée est gratuite pour les personnes en situation de handicap. Les modalités (justificatif, accompagnateur) seront précisées à l'ouverture de la billetterie.",
  },
  {
    q: "Comment vais-je recevoir mon billet ?",
    r: "Par e-mail, juste après votre achat. Vous pourrez le présenter sur votre téléphone ou imprimé à l'entrée du festival.",
  },
  {
    q: "Puis-je être remboursé ?",
    r: "Les conditions d'échange et de remboursement seront détaillées dans les conditions générales de vente, disponibles à l'ouverture de la billetterie.",
  },
];
---

<Base
  titre="Billetterie 2027 : pass 1, 2 ou 3 jours, camping"
  nomCourt="Billetterie"
  image="/partage/billetterie.jpg"
  donneesStructurees={faqSchema(questions)}
  description="Billets du festival Les Ragondins Farfelus 2027 : pass 1, 2 ou 3 jours, camping possible avec tous les pass. Musique et magie du 28 au 30 mai (Loiret)."
>
  <EnTetePage
    surtitre="Billetterie du festival 2027"
    titre="Votre billet pour l'autre monde"
    intro="Trois jours, trois ambiances, des surprises à chaque coin du domaine. Pass 1, 2 ou 3 jours, et le camping possible avec tous les pass."
  />

  <section class="section fond-nuit" aria-labelledby="titre-formules">
    <div class="contenu">
      <div class="titre-section">
        <span class="surtitre">Les formules</span>
        <h2 id="titre-formules">Choisissez votre passage</h2>
        <p class="intro">
          Chaque jour a son ambiance, ses artistes et ses surprises. Impossible de choisir&nbsp;?
          Prenez les trois. Tarifs dévoilés très bientôt&nbsp;: inscrivez-vous à la newsletter pour
          être prévenu en premier.
        </p>
      </div>

      <!-- Le pass 3 jours, mis en avant -->
      <article class="pass3" aria-labelledby="titre-pass3">
        <span class="pass3__ruban">Le plus magique</span>
        <div class="pass3__texte">
          <p class="pass3__date">Du vendredi 28 au dimanche 30 mai</p>
          <h3 id="titre-pass3">Pass 3 jours <span class="pass3__plus">+ camping</span></h3>
          <p class="pass3__accroche">
            Trois jours, zéro regret&nbsp;: la soirée d'ouverture, la nuit des têtes d'affiche, le
            grand final, et toutes les surprises entre les trois. Vous vivez tout, et vous dormez au
            cœur du domaine.
          </p>
        </div>
        <ul class="pass3__points">
          {pass3jours.points.map((p) => <li>{p}</li>)}
        </ul>
        <div class="pass3__achat">
          <p class="formule__prix">Tarif à venir</p>
          <a class="bouton bouton--rose" href={lienBouton} rel={billetterieOuverte ? "noopener" : undefined}>
            {billetterieOuverte ? "Réserver le pass 3 jours" : texteBouton}
          </a>
        </div>
      </article>

      <!-- Les pass jour -->
      <ul class="formules">
        {
          jours.map((j) => (
            <li class:list={["formule", `formule--${j.id}`]}>
              {j.ruban && <span class="formule__ruban">{j.ruban}</span>}
              <div class="formule__haut">
                <p class="formule__jour">{j.date}</p>
                <h3>{j.nom}</h3>
                <p class="formule__ambiance">{j.ambiance}</p>
              </div>
              <p class="formule__accroche">{j.accroche}</p>
              <ul class="formule__points">
                {j.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
              <p class="formule__pourqui">{j.pourQui}</p>
              <p class="formule__prix">Tarif à venir</p>
              <a class="bouton bouton--contour formule__bouton" href={lienBouton} rel={billetterieOuverte ? "noopener" : undefined}>
                {texteBouton}
              </a>
            </li>
          ))
        }
      </ul>

      <p class="autres-formules">
        <strong>Deux jours vous tentent&nbsp;?</strong> Un pass 2 jours sera aussi proposé. Et le
        camping est possible avec tous les pass, que vous veniez 1, 2 ou 3 jours.
      </p>

      <div class="inclus">
        <h3 class="inclus__titre">Dans tous les pass</h3>
        <ul>
          {
            inclus.map((i) => (
              <li>
                <strong>{i.titre}</strong>
                <span>{i.texte}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="encart gratuit">
        <p>
          <strong>Entrée gratuite</strong> pour les enfants de moins de 11&nbsp;ans et pour les
          personnes en situation de handicap.
        </p>
      </div>
    </div>
  </section>

  <section class="section fond-vert" id="reserver" aria-labelledby="titre-reserver">
    <div class="contenu">
      <h2 id="titre-reserver" class="sr-only">Réserver</h2>
      <ModuleExterne
        titre="Réservez vos places"
        texte="La billetterie s'ouvrira ici. Inscrivez-vous à la newsletter pour être prévenu dès l'ouverture."
        lien={liensExternes.billetterie}
        libelleBouton="Prendre mes billets"
      />
    </div>
  </section>

  <section class="section fond-nuit" aria-labelledby="titre-faq-billets">
    <div class="contenu">
      <div class="titre-section">
        <span class="surtitre">Questions fréquentes</span>
        <h2 id="titre-faq-billets">Tout savoir sur les billets</h2>
      </div>
      <Faq questions={questions} />
      <div class="boutons">
        <a class="bouton bouton--contour" href="/cashless/">Comment payer sur place ?</a>
        <a class="bouton bouton--contour" href="/infos/">Toutes les infos pratiques</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ----- Le pass 3 jours ----- */
  .pass3 {
    position: relative;
    display: grid;
    gap: 1.5rem clamp(2rem, 5vw, 3.5rem);
    grid-template-areas: "texte" "points" "achat";
    margin: 0 0 2.5rem;
    padding: clamp(2.25rem, 5vw, 3rem) clamp(1.5rem, 4vw, 3rem);
    border-radius: var(--rayon);
    border: 2px solid var(--rose);
    background:
      radial-gradient(ellipse 60% 90% at 0% 0%, rgba(255, 160, 203, 0.22), transparent 70%),
      radial-gradient(ellipse 50% 80% at 100% 100%, rgba(243, 226, 176, 0.14), transparent 70%),
      var(--vert-surface);
    box-shadow: 0 0 3.5rem rgba(255, 160, 203, 0.14);
  }

  .pass3__ruban,
  .formule__ruban {
    position: absolute;
    top: -0.9rem;
    left: 1.5rem;
    padding: 0.25rem 0.9rem;
    border-radius: 999px;
    background: var(--rose);
    color: var(--vert);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .pass3__texte {
    grid-area: texte;
  }

  .pass3__points {
    grid-area: points;
  }

  .pass3__achat {
    grid-area: achat;
  }

  /* Sur grand écran : le texte et le bouton à gauche, les avantages à droite */
  @media (min-width: 52rem) {
    .pass3 {
      grid-template-columns: 1fr 1fr;
      grid-template-areas: "texte points" "achat points";
      align-items: center;
    }
  }

  .pass3__date {
    margin: 0 0 0.4rem;
    color: var(--rose);
    font-weight: 600;
  }

  .pass3 h3 {
    margin: 0 0 0.9rem;
    font-size: clamp(2rem, 5vw, 2.9rem);
  }

  .pass3__plus {
    background: linear-gradient(180deg, var(--or-clair), var(--or));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .pass3__accroche {
    margin: 0;
    font-size: 1.1rem;
  }

  .pass3 .formule__prix {
    margin-bottom: 1.25rem;
  }

  .pass3__points,
  .formule__points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }

  .pass3__points li,
  .formule__points li {
    position: relative;
    padding-left: 1.75rem;
  }

  /* Petite étoile dorée devant chaque point */
  .pass3__points li::before,
  .formule__points li::before {
    content: "✦";
    position: absolute;
    left: 0;
    top: 0;
    background: linear-gradient(180deg, var(--or-clair), var(--or-fonce));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .pass3__points li {
    font-size: 1.05rem;
  }

  /* ----- Les pass jour (en arche, comme le miroir) ----- */
  .formules {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: grid;
    gap: 2.5rem 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }

  .formule {
    --accent: var(--rose);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2.25rem 1.5rem 1.75rem;
    border-radius: 12rem 12rem var(--rayon) var(--rayon);
    border: 1.5px solid color-mix(in srgb, var(--accent) 55%, transparent);
    background:
      radial-gradient(ellipse 80% 45% at 50% 0%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 75%),
      var(--vert-surface);
  }

  .formule--samedi {
    --accent: var(--or-clair);
  }

  .formule .formule__ruban {
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    background: var(--accent);
  }

  .formule--dimanche {
    --accent: #8fd6c4;
  }

  .formule__haut {
    text-align: center;
    padding-top: 0.75rem;
  }

  .formule__jour {
    margin: 0 0 0.35rem;
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .formule h3 {
    margin: 0;
    font-size: clamp(1.6rem, 3.2vw, 1.9rem);
  }

  .formule__ambiance {
    margin: 0.3rem 0 0;
    font-family: var(--font-titre);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--accent);
  }

  .formule__accroche {
    margin: 0;
    color: var(--creme-doux);
  }

  .formule__points {
    flex: 1;
    align-content: start;
  }

  .formule__pourqui {
    margin: 0;
    align-self: flex-start;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 50%, transparent);
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .formule__prix {
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid rgba(243, 226, 176, 0.18);
    font-family: var(--font-titre);
    font-size: 1.3rem;
    color: var(--or-clair);
  }

  .formule__bouton {
    align-self: stretch;
    justify-content: center;
    text-align: center;
  }

  .autres-formules {
    margin: 0 0 2rem;
    text-align: center;
    color: var(--creme-doux);
  }

  .autres-formules strong {
    color: var(--creme);
  }

  /* ----- Inclus dans tous les pass ----- */
  .inclus {
    margin: 0 0 2rem;
    padding: 1.5rem clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--rayon);
    border: 1px dashed rgba(243, 226, 176, 0.35);
  }

  .inclus__titre {
    margin: 0 0 1rem;
    font-size: 1.25rem;
  }

  .inclus ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  }

  .inclus strong {
    display: block;
    color: var(--creme);
  }

  .inclus span {
    font-size: 0.92rem;
    color: var(--creme-doux);
  }

  .gratuit p {
    margin: 0;
    font-size: 1.1rem;
  }
</style>
