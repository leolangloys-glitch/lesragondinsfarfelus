---
import Base from "../layouts/Base.astro";
import EnTetePage from "../components/EnTetePage.astro";
import Faq from "../components/Faq.astro";
import Video from "../components/Video.astro";
import Formulaire from "../components/Formulaire.astro";
import Clips from "../components/Clips.astro";
import Phototheque from "../components/Phototheque.astro";
import { emailBenevoles, faqSchema, liensExternes, SITE } from "../data/site";
import souvenirs from "../data/souvenirs.json";

// Les avantages des bénévoles (confirmés par l'équipe en novembre 2026)
const avantages = [
  {
    titre: "Le festival en accès libre",
    texte: "En dehors de vos créneaux, vous profitez du festival comme tout le monde : concerts, DJ sets, magie.",
    icone: "✦",
  },
  {
    titre: "Les repas offerts",
    texte: "Pendant vos missions, on s'occupe de vous : vos repas sont pris en charge.",
    icone: "❦",
  },
  {
    titre: "Le t-shirt officiel",
    texte: "Celui de la troupe des bénévoles : vous le garderez en souvenir.",
    icone: "✿",
  },
  {
    titre: "Une équipe en or",
    texte: "Des rencontres, des fous rires et la fierté de faire vivre un festival unique dans le Loiret.",
    icone: "❀",
  },
];

const missions = [
  { titre: "Accueil et billetterie", texte: "Être le premier sourire du festival et guider les visiteurs vers le portail." },
  { titre: "Bar et restauration", texte: "Servir, trinquer, garder le rythme quand la foule a soif." },
  { titre: "Scènes", texte: "Épauler les équipes techniques et accueillir les artistes." },
  { titre: "Montage et démontage", texte: "Construire le monde des Ragondins avant tout le monde, et le ranger après." },
  { titre: "Décors et scénographie", texte: "Donner vie à l'univers magique : lumières, installations, détails farfelus." },
  { titre: "Camping et environnement", texte: "Veiller au confort des campeurs et à la propreté du domaine." },
];

const questions = [
  {
    q: "Faut-il de l'expérience ?",
    r: "La plupart des missions ne demandent aucune expérience particulière : l'envie et la bonne humeur suffisent. Nous vous expliquons tout avant le festival.",
  },
  {
    q: "Combien de temps dois-je donner ?",
    r: "Vous choisissez vos créneaux en fonction de vos disponibilités. Le reste du temps, profitez du festival !",
  },
  {
    q: "Y a-t-il un âge minimum ?",
    r: "Indiquez votre âge dans le formulaire : nous revenons vers vous avec les conditions. Pour les mineurs, une autorisation parentale est demandée.",
  },
  {
    q: "Pourquoi vous demandez mes qualités et mes défauts ?",
    r: "Pour mieux vous connaître et vous proposer la mission qui vous ressemble. Il n'y a pas de mauvaise réponse : on a tous nos petits défauts, et un peu d'humour est bienvenu !",
  },
];
---

<Base
  titre="Devenir bénévole dans un festival du Loiret"
  nomCourt="Devenir bénévole"
  image="/partage/benevoles.jpg"
  donneesStructurees={[
    faqSchema(questions),
    ...souvenirs.videosBenevoles.map((v) => ({
      "@context": "https://schema.org",
      "@type": "VideoObject",
      name: v.legende || "Les bénévoles du festival en 2026",
      description: `${v.legende || "Les bénévoles"} : la troupe des bénévoles des Ragondins Farfelus pendant l'édition 2026, au Domaine de Briquemault (Loiret).`,
      thumbnailUrl: new URL(v.affiche || "/brouillon/partage.jpg", SITE).href,
      contentUrl: new URL(v.video, SITE).href,
      uploadDate: "2026-06-01",
      inLanguage: "fr-FR",
    })),
  ]}
  description="Rejoignez les bénévoles des Ragondins Farfelus, 28-30 mai 2027 au Domaine de Briquemault (Loiret), près de Montargis : accueil, bar, scènes, décors…"
>
  <EnTetePage
    surtitre="Devenir bénévole en 2027"
    titre="Rejoignez la troupe des Ragondins"
    intro="Sans bénévoles, pas de magie. Vivez le festival de l'intérieur, profitez-en en dehors de vos créneaux, repas offerts pendant vos missions, et repartez avec des souvenirs plein la tête."
  >
    <div class="boutons">
      <a class="bouton bouton--rose" href="#inscription">Je m'inscris</a>
    </div>
  </EnTetePage>

  <section class="section fond-vert avantages-section" aria-labelledby="titre-avantages">
    <div class="contenu">
      <div class="titre-section">
        <span class="surtitre">De l'autre côté du rideau</span>
        <h2 id="titre-avantages">Ce que vous y gagnez</h2>
      </div>
      <ul class="avantages">
        {
          avantages.map((v) => (
            <li class="avantage">
              <span class="avantage__icone" aria-hidden="true">{v.icone}</span>
              <h3>{v.titre}</h3>
              <p>{v.texte}</p>
            </li>
          ))
        }
      </ul>
      <div class="boutons">
        <a class="bouton bouton--rose" href="#inscription">Je deviens bénévole</a>
      </div>
    </div>
  </section>

  <section class="section fond-nuit" id="en-images" aria-labelledby="titre-troupe-2026">
    <div class="contenu">
      <div class="titre-section">
        <span class="surtitre">Ils l'ont vécu en 2026</span>
        <h2 id="titre-troupe-2026">La troupe 2026 en action</h2>
        <p class="intro">
          Des sourires, des fous rires et beaucoup de frites&nbsp;: la première édition vue des
          coulisses, par celles et ceux qui l'ont fait vivre.
        </p>
      </div>
      <Clips clips={souvenirs.videosBenevoles} />
      <Phototheque photos={souvenirs.photosBenevoles} vides={0} />
      {
        souvenirs.aftermovieBenevoles ? (
          <div class="aftermovie-benevoles">
            <h3>L'aftermovie des bénévoles</h3>
            <Video lien={souvenirs.aftermovieBenevoles} titre="L'aftermovie des bénévoles 2026" />
          </div>
        ) : (
          <p class="note">L'aftermovie complet des bénévoles arrive bientôt&nbsp;: restez connectés&nbsp;!</p>
        )
      }
    </div>
  </section>

  <section class="section fond-vert" aria-labelledby="titre-missions">
    <div class="contenu">
      <div class="titre-section">
        <span class="surtitre">Les missions</span>
        <h2 id="titre-missions">Trouvez votre rôle dans le spectacle</h2>
      </div>
      <div class="grille">
        {
          missions.map((m) => (
            <article class="carte">
              <h3>{m.titre}</h3>
              <p class="texte-doux">{m.texte}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>



  <section class="section fond-nuit" aria-labelledby="titre-deroule">
    <div class="contenu">
      <div class="titre-section">
        <span class="surtitre">Comment ça se passe</span>
        <h2 id="titre-deroule">De l'inscription au grand week-end</h2>
      </div>
      <ol class="etapes">
        <li><h3>Inscrivez-vous</h3><p>Remplissez le formulaire en quelques minutes.</p></li>
        <li><h3>On vous rappelle</h3><p>Nous choisissons ensemble votre mission et vos créneaux.</p></li>
        <li><h3>Le briefing</h3><p>Avant le festival, on vous explique tout et on rencontre l'équipe.</p></li>
        <li><h3>La magie opère</h3><p>Les 28, 29 et 30 mai, vous faites partie du spectacle.</p></li>
      </ol>
    </div>
  </section>

  <section class="section fond-vert" id="inscription" aria-labelledby="titre-inscription">
    <div class="contenu">
      <div class="titre-section">
        <span class="surtitre">Inscriptions 2027 ouvertes</span>
        <h2 id="titre-inscription">Le formulaire d'inscription</h2>
        <p class="intro">
          Quelques minutes suffisent. Pas besoin d'être parfait&nbsp;: on veut surtout vous connaître
          un peu. Nous lisons chaque candidature et revenons vers vous par e-mail ou par téléphone.
        </p>
      </div>
      <div class="carte inscription">
        <Formulaire
          id="inscription-benevole"
          sujet="Inscription bénévole · Les Ragondins Farfelus 2027"
          bouton="Envoyer ma candidature"
          destinataire={emailBenevoles}
          lienExterne={liensExternes.formulaireBenevoles}
          champs={[
            { nom: "nom", libelle: "Prénom et nom", requis: true, autocomplete: "name" },
            { nom: "email", libelle: "E-mail", type: "email", requis: true, autocomplete: "email" },
            { nom: "telephone", libelle: "Téléphone", type: "tel", requis: true, autocomplete: "tel" },
            { nom: "ville", libelle: "Ville", autocomplete: "address-level2", aide: "Pour organiser les covoiturages." },
            {
              nom: "age",
              libelle: "Votre âge",
              type: "select",
              requis: true,
              options: ["Moins de 18 ans", "18 à 25 ans", "26 à 40 ans", "41 à 60 ans", "Plus de 60 ans"],
            },
            {
              nom: "tshirt",
              libelle: "Taille de t-shirt",
              type: "select",
              options: ["XS", "S", "M", "L", "XL", "XXL"],
            },
            {
              nom: "disponibilites",
              libelle: "Vos disponibilités",
              type: "cases",
              requis: true,
              aide: "Cochez tout ce qui est possible pour vous.",
              options: [
                "Montage (les jours avant le festival)",
                "Vendredi 28 mai",
                "Samedi 29 mai",
                "Dimanche 30 mai",
                "Démontage (les jours après le festival)",
              ],
            },
            {
              nom: "missions",
              libelle: "Les missions qui vous tentent",
              type: "cases",
              aide: "Plusieurs choix possibles. Rien n'est figé : on en parle ensemble.",
              options: [...missions.map((m) => m.titre), "Peu importe, je suis partant pour tout !"],
            },
            {
              nom: "qualites",
              libelle: "Quelques qualités",
              type: "textarea",
              requis: true,
              lignes: 3,
              max: 600,
              aide: "Comment vos proches vous décriraient-ils ? Trois mots ou trois phrases suffisent.",
            },
            {
              nom: "defauts",
              libelle: "Et quelques défauts",
              type: "textarea",
              requis: true,
              lignes: 3,
              max: 600,
              aide: "On a tous les nôtres ! Un peu d'honnêteté (et d'humour) est bienvenu.",
            },
            {
              nom: "motivation",
              libelle: "Pourquoi voulez-vous devenir bénévole aux Ragondins Farfelus ?",
              type: "textarea",
              requis: true,
              lignes: 4,
              max: 1000,
            },
            {
              nom: "experience",
              libelle: "Avez-vous déjà vécu une expérience similaire, de près ou de loin ?",
              type: "choix",
              requis: true,
              options: [
                "Oui, j'ai déjà été bénévole sur un festival ou un événement",
                "De loin : associatif, accueil du public, restauration, animation, spectacle…",
                "Non, ce sera une première (et c'est très bien comme ça !)",
              ],
            },
            {
              nom: "experience-detail",
              libelle: "Racontez-nous en quelques mots",
              type: "textarea",
              lignes: 3,
              max: 800,
              aide: "Où, quand, quel rôle… même si le lien est lointain, tout nous intéresse.",
            },
          ]}
        />
      </div>
      <p class="note">
        Vos réponses servent uniquement à constituer l'équipe bénévole du festival et ne sont jamais
        transmises à des tiers. En savoir plus&nbsp;: <a href="/confidentialite/">politique de confidentialité</a>.
      </p>
    </div>
  </section>

  <section class="section fond-nuit" aria-labelledby="titre-faq-benevoles">
    <div class="contenu">
      <div class="titre-section">
        <span class="surtitre">Questions fréquentes</span>
        <h2 id="titre-faq-benevoles">Avant de vous lancer</h2>
      </div>
      <Faq questions={questions} />
    </div>
  </section>
</Base>

<style>
  .avantages {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }

  .avantage {
    padding: 2rem 1.5rem 1.75rem;
    border-radius: 999px 999px var(--rayon) var(--rayon);
    border: 1.5px solid var(--or);
    background: radial-gradient(ellipse at 50% 20%, rgba(255, 160, 203, 0.2), rgba(5, 40, 40, 0.65));
    text-align: center;
  }

  .avantage__icone {
    display: block;
    font-size: 2.4rem;
    line-height: 1;
    margin-bottom: 0.75rem;
    background: linear-gradient(180deg, var(--or-clair), var(--or-fonce));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .avantage h3 {
    margin-bottom: 0.5rem;
    font-size: 1.3rem;
  }

  .avantage p {
    margin: 0;
    color: var(--creme-doux);
  }

  .inscription {
    max-width: 52rem;
  }

  .aftermovie-benevoles {
    margin-top: 2.5rem;
  }

  .aftermovie-benevoles h3 {
    margin-bottom: 1rem;
  }

  .note {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    color: var(--creme-doux);
  }
</style>
