---
import Base from "../layouts/Base.astro";
import { evenementSchema } from "../data/site";
import { habitants, photoAccueil, urlsLicences } from "../data/photos";

// Textes provisoires : à relire et valider par l'équipe avant la mise en ligne.
const univers = [
  {
    titre: "La musique",
    texte:
      "Jazz, jazz manouche, rock, pop et DJ sets jusqu'au bout de la nuit, sur plusieurs scènes nichées dans le domaine.",
    icone: "musique",
  },
  {
    titre: "La magie",
    texte:
      "De grands numéros d'illusion sur scène et des magiciens qui surgissent au milieu du public, à quelques centimètres de vous.",
    icone: "magie",
  },
  {
    titre: "La nature",
    texte:
      "Dix hectares de nature préservée au bord du Loing, transformés le temps d'un week-end en monde onirique.",
    icone: "nature",
  },
];

const jours = [
  {
    jour: "Vendredi",
    date: "28 mai",
    titre: "L'éveil",
    texte: "Ouverture du camping, premiers concerts en fin d'après-midi, puis DJ sets jusque tard dans la nuit.",
  },
  {
    jour: "Samedi",
    date: "29 mai",
    titre: "La grande nuit",
    texte: "Magiciens sur scène et en close-up, concerts toute la journée et grande soirée avec nos têtes d'affiche.",
  },
  {
    jour: "Dimanche",
    date: "30 mai",
    titre: "La journée des familles",
    texte: "Artistes pour les enfants, magie à hauteur d'yeux, jeux et animations pour tous les âges.",
  },
];
---

<Base
  accueil
  titre="Les Ragondins Farfelus · Festival de musique et de magie · 28-30 mai 2027"
  description="Festival de musique et de magie au Domaine de Briquemault (Loiret), les 28, 29 et 30 mai 2027. Concerts, DJ sets, magiciens. Au profit de Handi'Chiens."
  donneesStructurees={evenementSchema()}
>
  <!-- ===================== OUVERTURE : LE PORTAIL ET LE LOING ===================== -->
  <!--
    États (attribut data-etat) :
      monde     : la photo du Loing en plein écran avec les infos (état par défaut,
                  sans JavaScript, et ce que voit Google)
      seuil     : le portail doré, avec le monde visible à travers ; on invite à entrer
      traversee : le portail s'agrandit jusqu'à remplir l'écran
  -->
  <section class="ouverture" data-etat="monde" aria-labelledby="titre-festival">
    <div class="ouverture__photo">
      <img
        src={`${photoAccueil.base}-1600.webp`}
        srcset={photoAccueil.largeurs.map((l) => `${photoAccueil.base}-${l}.webp ${l}w`).join(", ")}
        sizes="100vw"
        alt={photoAccueil.alt}
        width={photoAccueil.largeur}
        height={photoAccueil.hauteur}
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="ouverture__voile" aria-hidden="true"></div>
    <canvas class="ouverture__lucioles" aria-hidden="true"></canvas>

    <div class="ouverture__contenu">
      <div class="ouverture__haut">
        <h1 id="titre-festival" class="ouverture__logo">
          <img src="/brouillon/logo.webp" alt="Les Ragondins Farfelus" width="1200" height="717" />
        </h1>
        <p class="ouverture__badge">Festival de musique et de magie</p>
        <p class="ouverture__infos">
          <span class="ouverture__dates texte-or">28·29·30 mai 2027</span>
          <span class="ouverture__lieu">Domaine de Briquemault<span class="ouverture__commune"> · Sainte-Geneviève-des-Bois (Loiret)</span></span>
        </p>
        <p class="ouverture__genres">Magie · DJ sets · Concerts jazz et rock · Au bord du Loing</p>
      </div>
      <div class="ouverture__actions">
        <a class="bouton bouton--rose" href="/billetterie/">Billetterie</a>
        <a class="bouton bouton--contour" href="/programmation/">Programmation</a>
      </div>
    </div>

    <div class="seuil">
      <div class="seuil__portail">
        <div class="seuil__fenetre" aria-hidden="true"></div>
        <img class="seuil__cadre" src="/brouillon/cadre-or.webp" alt="" width="1007" height="1292" />
      </div>
      <p class="seuil__invitation">Au bord du Loing, un monde s'éveille une fois par an.</p>
      <button class="bouton bouton--rose seuil__entrer" type="button">Entrer dans le monde</button>
      <button class="seuil__passer" type="button">Passer l'introduction</button>
    </div>

    <p class="ouverture__credit">
      Photo : {photoAccueil.credit.auteur},
      <a href={urlsLicences[photoAccueil.credit.licence]} rel="noopener license">{photoAccueil.credit.licence}</a>, couleurs modifiées
    </p>

    <a class="ouverture__suite" href="#experience" aria-label="Découvrir le festival">
      <span aria-hidden="true"></span>
    </a>
  </section>
  <script is:inline>
    // Avant le premier affichage : on montre le portail si on n'est pas encore entré
    // et si le visiteur n'a pas demandé à réduire les animations.
    (function () {
      var o = document.querySelector(".ouverture");
      var entre = false;
      try { entre = sessionStorage.getItem("rf-entre") === "1"; } catch (e) {}
      if (o && !entre && !matchMedia("(prefers-reduced-motion: reduce)").matches) o.dataset.etat = "seuil";
    })();
  </script>

  <!-- ===================== L'EXPÉRIENCE ===================== -->
  <section class="section experience" id="experience" aria-labelledby="titre-experience">
    <div class="contenu">
      <span class="surtitre">Le festival</span>
      <h2 id="titre-experience">Là où la musique rencontre l'illusion</h2>
      <p class="intro">
        Un monde mystérieux, onirique et hors du temps qui s'éveille une fois par an au cœur du
        Loiret. Trois jours pour vivre une expérience immersive, entre nature, musique puissante et
        magie.
      </p>

      <ul class="arches">
        {
          univers.map((u) => (
            <li class="arche">
              <span class="arche__icone" aria-hidden="true">
                {u.icone === "musique" && (
                  <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 36V10l20-4v26" />
                    <circle cx="13" cy="36" r="5" />
                    <circle cx="33" cy="32" r="5" />
                  </svg>
                )}
                {u.icone === "magie" && (
                  <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M24 4c1.5 9 4 11.5 13 13-9 1.5-11.5 4-13 13-1.5-9-4-11.5-13-13 9-1.5 11.5-4 13-13Z" />
                    <path d="M38 30c.7 4 1.8 5.2 6 6-4.2.8-5.3 2-6 6-.7-4-1.8-5.2-6-6 4.2-.8 5.3-2 6-6Z" />
                  </svg>
                )}
                {u.icone === "nature" && (
                  <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10 40C10 20 22 8 40 8c0 18-12 30-30 32Z" />
                    <path d="M10 40 30 18" />
                  </svg>
                )}
              </span>
              <h3>{u.titre}</h3>
              <p>{u.texte}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ===================== LES HABITANTS DU LOING ===================== -->
  <section class="section habitants" id="habitants" aria-labelledby="titre-habitants">
    <div class="contenu">
      <div class="titre-section">
        <span class="surtitre">Faune et flore du Loiret</span>
        <h2 id="titre-habitants">Les habitants du Loing</h2>
        <p class="intro">
          Le festival s'installe au bord du Loing, dans une nature préservée. Voici quelques-uns de
          nos voisins : bien réels, un brin magiques, ils ont inspiré le monde des Ragondins
          Farfelus.
        </p>
      </div>
      <ul class="habitants__liste">
        {
          habitants.map((h, i) => (
            <li class:list={["habitant", { "habitant--vedette": i === 0 }]}>
              <figure>
                <div class="habitant__cadre">
                  <img src={h.fichier} alt={h.alt} width="800" height="1000" loading="lazy" decoding="async" />
                </div>
                <figcaption>
                  <h3>{h.nom}</h3>
                  <p class="habitant__latin">{h.latin}</p>
                  <p class="habitant__texte">{h.texte}</p>
                  <p class="habitant__credit">
                    Photo : <a href={h.credit.source} rel="noopener">{h.credit.auteur}</a>,{" "}
                    <a href={urlsLicences[h.credit.licence]} rel="noopener license">{h.credit.licence}</a>
                  </p>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ===================== PROGRAMME ===================== -->
  <section class="section programme" id="programme" aria-labelledby="titre-programme">
    <div class="contenu">
      <span class="surtitre">Programmation</span>
      <h2 id="titre-programme">Trois jours, trois ambiances</h2>
      <p class="intro">Les artistes seront dévoilés au fil des semaines. Restez à l'affût&nbsp;!</p>

      <ol class="jours">
        {
          jours.map((j) => (
            <li class="jour">
              <p class="jour__date">
                <span class="jour__nom">{j.jour}</span>
                <span class="texte-or">{j.date}</span>
              </p>
              <h3>{j.titre}</h3>
              <p>{j.texte}</p>
            </li>
          ))
        }
      </ol>
      <div class="boutons">
        <a class="bouton bouton--contour" href="/programmation/">Toute la programmation</a>
      </div>
    </div>
  </section>

  <!-- ===================== BILLETTERIE ===================== -->
  <section class="section billetterie" aria-labelledby="titre-billetterie">
    <div class="contenu billetterie__carte">
      <div>
        <span class="surtitre">Billetterie</span>
        <h2 id="titre-billetterie">Ouverture prochaine</h2>
        <p>
          Pass jour, pass 3 jours, camping : toutes les formules seront disponibles à l'ouverture de
          la billetterie.
        </p>
        <div class="boutons">
          <a class="bouton bouton--rose" href="/billetterie/">Voir les formules</a>
        </div>
      </div>
      <p class="billetterie__gratuit">
        <strong>Entrée gratuite</strong> pour les moins de 11&nbsp;ans et les personnes en situation
        de handicap.
      </p>
    </div>
  </section>

  <!-- ===================== RETOUR SUR 2026 ===================== -->
  <section class="section retour" aria-labelledby="titre-retour">
    <div class="contenu">
      <div class="titre-section">
        <span class="surtitre">Retour sur 2026</span>
        <h2 id="titre-retour">La première fois que le portail s'est ouvert</h2>
        <p class="intro">
          Les 30 et 31 mai 2026, le Domaine de Briquemault accueillait la toute première édition des
          Ragondins Farfelus. Magie, jazz, rock, guinguette et DJ sets&nbsp;: retour en images.
        </p>
      </div>
      <ul class="retour__photos" aria-label="Photos de l'édition 2026 (à venir)">
        <li><span>Photo à venir</span></li>
        <li><span>Photo à venir</span></li>
        <li><span>Photo à venir</span></li>
        <li><span>Vidéo à venir</span></li>
      </ul>
    </div>
  </section>

  <!-- ===================== SOLIDARITÉ ===================== -->
  <section class="section solidarite" aria-labelledby="titre-solidarite">
    <div class="contenu solidarite__grille">
      <div>
        <span class="surtitre">Un festival solidaire</span>
        <h2 id="titre-solidarite">Au profit de Handi'Chiens</h2>
      </div>
      <div>
        <p class="intro">
          Les Ragondins Farfelus soutiennent l'association Handi'Chiens, qui éduque et remet
          gratuitement des chiens d'assistance à des personnes en situation de handicap.
        </p>
        <p>
          Chaque billet, chaque verre partagé au bar contribue à offrir un compagnon à quatre pattes
          à celles et ceux qui en ont besoin.
        </p>
      </div>
    </div>
  </section>

  <!-- ===================== LE LIEU ===================== -->
  <section class="section lieu" aria-labelledby="titre-lieu">
    <div class="contenu">
      <span class="surtitre">Le lieu</span>
      <h2 id="titre-lieu">Le Domaine de Briquemault</h2>
      <p class="intro">
        Un domaine chargé d'histoire au cœur du Loiret, entre château, orangerie et guinguette,
        qui ouvre ses portes au festival le temps d'un week-end.
      </p>

      <dl class="chiffres">
        <div>
          <dt>Hectares de nature</dt>
          <dd class="texte-or">10</dd>
        </div>
        <div>
          <dt>De Paris</dt>
          <dd class="texte-or">1 h 30</dd>
        </div>
        <div>
          <dt>Jours de festival</dt>
          <dd class="texte-or">3</dd>
        </div>
      </dl>

      <div class="boutons">
        <a class="bouton bouton--contour" href="/domaine/">Découvrir le domaine</a>
        <a class="bouton bouton--contour" href="/infos/#venir">Comment venir</a>
      </div>
    </div>
  </section>

  <!-- ===================== REJOINDRE L'AVENTURE ===================== -->
  <section class="rejoindre" aria-labelledby="titre-rejoindre">
    <div class="contenu rejoindre__contenu">
      <div>
        <h2 id="titre-rejoindre">Rejoignez l'aventure</h2>
        <p>
          Bénévoles, entreprises, médias : il y a mille façons de faire partie du monde des
          Ragondins.
        </p>
      </div>
      <div class="rejoindre__boutons">
        <a class="bouton bouton--vert" href="/benevoles/">Devenir bénévole</a>
        <a class="bouton bouton--vert" href="/partenaires/">Devenir partenaire</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Entrée par le miroir (sans 3D : animation CSS + lucioles dessinées en 2D, très léger)
  const ouverture = document.querySelector<HTMLElement>(".ouverture");
  const portail = document.querySelector<HTMLElement>(".seuil__portail");
  const canvas = document.querySelector<HTMLCanvasElement>(".ouverture__lucioles");
  const reduit = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function memoriserEntree() {
    try {
      sessionStorage.setItem("rf-entre", "1");
    } catch {
      /* navigation privée : sans importance */
    }
  }

  function arriver() {
    if (!ouverture) return;
    ouverture.dataset.etat = "monde";
    memoriserEntree();
    ouverture.querySelector<HTMLElement>(".ouverture__actions a")?.focus({ preventScroll: true });
  }

  function entrer() {
    if (!ouverture || !portail || ouverture.dataset.etat !== "seuil") return;
    const r = portail.getBoundingClientRect();
    const zone = ouverture.getBoundingClientRect();
    // Agrandit le miroir jusqu'à ce que son ouverture couvre tout l'écran
    const zoom = Math.max(zone.width / (r.width * 0.86), zone.height / (r.height * 0.88)) * 1.15;
    portail.style.setProperty("--dx", `${zone.left + zone.width / 2 - (r.left + r.width / 2)}px`);
    portail.style.setProperty("--dy", `${zone.top + zone.height / 2 - (r.top + r.height / 2)}px`);
    portail.style.setProperty("--zoom", String(zoom));
    ouverture.dataset.etat = "traversee";
    window.setTimeout(arriver, 1700);
  }

  document.querySelector(".seuil__entrer")?.addEventListener("click", entrer);
  portail?.addEventListener("click", entrer);
  document.querySelector(".seuil__passer")?.addEventListener("click", arriver);

  // Léger effet de profondeur quand on bouge la souris
  if (ouverture && !reduit && window.matchMedia("(pointer: fine)").matches) {
    ouverture.addEventListener("pointermove", (e) => {
      const r = ouverture.getBoundingClientRect();
      ouverture.style.setProperty("--px", (((e.clientX - r.left) / r.width) * 2 - 1).toFixed(3));
      ouverture.style.setProperty("--py", (((e.clientY - r.top) / r.height) * 2 - 1).toFixed(3));
    });
  }

  // Lucioles : points lumineux flous, jaune-vert et rose, qui flottent et clignotent
  if (canvas && ouverture) {
    const ctx = canvas.getContext("2d");
    const petit = window.innerWidth < 700;
    const teintes = ["255,236,120", "214,245,107", "255,236,120", "255,160,203", "255,246,216"];
    const lucioles = Array.from({ length: petit ? 36 : 64 }, () => ({
      x: Math.random(),
      y: 0.15 + Math.random() * 0.85,
      r: 1.6 + Math.pow(Math.random(), 3) * 10,
      teinte: teintes[Math.floor(Math.random() * teintes.length)],
      vx: (Math.random() - 0.5) * 0.000012,
      vy: -(0.000004 + Math.random() * 0.000014),
      phase: Math.random() * Math.PI * 2,
      rythme: 0.5 + Math.random() * 1.3,
    }));
    let l = 0;
    let h = 0;
    const tailler = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      l = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = Math.round(l * dpr);
      canvas.height = Math.round(h * dpr);
      ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    const dessiner = (t: number) => {
      if (!ctx) return;
      ctx.clearRect(0, 0, l, h);
      ctx.globalCompositeOperation = "lighter";
      for (const p of lucioles) {
        const x = ((((p.x + p.vx * t) % 1) + 1) % 1) * l + Math.sin(t * 0.0004 + p.phase) * 14;
        const y = ((((p.y + p.vy * t) % 1) + 1) % 1) * h + Math.cos(t * 0.0003 + p.phase) * 10;
        const a = reduit ? 0.6 : Math.max(0, Math.sin(t * 0.001 * p.rythme + p.phase)) * 0.85 + 0.1;
        const rayon = p.r * 3;
        const g = ctx.createRadialGradient(x, y, 0, x, y, rayon);
        g.addColorStop(0, `rgba(${p.teinte},${a})`);
        g.addColorStop(0.3, `rgba(${p.teinte},${a * 0.55})`);
        g.addColorStop(1, `rgba(${p.teinte},0)`);
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(x, y, rayon, 0, Math.PI * 2);
        ctx.fill();
      }
    };
    tailler();
    new ResizeObserver(() => {
      tailler();
      if (reduit) dessiner(0);
    }).observe(canvas);
    if (reduit) {
      dessiner(0);
    } else {
      let visible = true;
      let boucle = 0;
      const image = (t: number) => {
        boucle = 0;
        if (!visible || document.hidden) return;
        dessiner(t);
        boucle = requestAnimationFrame(image);
      };
      const relancer = () => {
        if (!boucle && visible && !document.hidden) boucle = requestAnimationFrame(image);
      };
      new IntersectionObserver(([e]) => {
        visible = e.isIntersecting;
        relancer();
      }).observe(ouverture);
      document.addEventListener("visibilitychange", relancer);
      relancer();
    }
  }
</script>

<style>
  /* ---------- Ouverture : le miroir puis le monde du Loing ---------- */
  .ouverture {
    --px: 0;
    --py: 0;
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    isolation: isolate;
    background: radial-gradient(ellipse 70% 60% at 50% 45%, #0e5650 0%, var(--vert) 45%, var(--vert-nuit) 100%);
  }

  .ouverture__photo {
    position: absolute;
    inset: -2%;
    z-index: 0;
    transition: opacity 0.9s ease;
  }

  .ouverture__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% 42%;
    transform: translate3d(calc(var(--px) * -12px), calc(var(--py) * -9px), 0) scale(1.03);
    transition: transform 1.2s ease-out;
  }

  .ouverture[data-etat="monde"] .ouverture__photo img {
    animation: respiration 26s ease-in-out infinite alternate;
  }

  @keyframes respiration {
    from {
      scale: 1.06;
    }
    to {
      scale: 1;
    }
  }

  .ouverture__voile {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(5, 40, 40, 0.88) 0%, rgba(5, 40, 40, 0.55) 34%, rgba(5, 40, 40, 0) 62%),
      linear-gradient(0deg, rgba(5, 40, 40, 0.75) 0%, rgba(5, 40, 40, 0) 30%),
      radial-gradient(ellipse 40% 50% at 92% 4%, rgba(255, 160, 203, 0.22), transparent 70%);
    transition: opacity 0.9s ease;
  }

  .ouverture__lucioles {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    pointer-events: none;
    transform: translate3d(calc(var(--px) * 10px), calc(var(--py) * 8px), 0);
    transition: transform 1.2s ease-out;
  }

  .ouverture__contenu {
    position: relative;
    z-index: 3;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2rem;
    width: min(100%, var(--largeur-max));
    margin: 0 auto;
    padding: calc(var(--hauteur-entete) + 2rem) var(--marge) 5rem;
    transition: opacity 0.8s ease;
  }

  .ouverture__haut {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    max-width: 30rem;
  }

  .ouverture__logo {
    margin: 0;
    width: min(100%, 26rem);
    filter: drop-shadow(0 0.5rem 1.8rem rgba(0, 0, 0, 0.55));
  }

  .ouverture__logo img {
    width: 100%;
  }

  .ouverture__badge {
    margin: 0;
    padding: 0.35em 1.1em;
    border: 1.5px solid var(--creme);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: rgba(5, 40, 40, 0.35);
  }

  .ouverture__infos {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .ouverture__dates {
    font-family: var(--font-titre);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    line-height: 1.1;
  }

  .ouverture__lieu {
    font-weight: 600;
    color: var(--creme);
  }

  .ouverture__genres {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--rose);
  }

  .ouverture__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }

