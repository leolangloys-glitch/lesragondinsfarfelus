---
import Base from "../layouts/Base.astro";
import { evenementSchema, festival } from "../data/site";

// Textes provisoires : à relire et valider par l'équipe avant la mise en ligne.
const univers = [
  {
    titre: "La musique",
    texte:
      "Jazz, jazz manouche, rock, pop et DJ sets jusqu'au bout de la nuit, sur plusieurs scènes nichées dans le domaine.",
    icone: "musique",
  },
  {
    titre: "La magie",
    texte:
      "De grands numéros d'illusion sur scène et des magiciens qui surgissent au milieu du public, à quelques centimètres de vous.",
    icone: "magie",
  },
  {
    titre: "La nature",
    texte:
      "Dix hectares de nature préservée au bord du Loing, transformés le temps d'un week-end en monde onirique.",
    icone: "nature",
  },
];

const jours = [
  {
    jour: "Vendredi",
    date: "28 mai",
    titre: "L'éveil",
    texte: "Ouverture du camping, premiers concerts en fin d'après-midi, puis DJ sets jusque tard dans la nuit.",
  },
  {
    jour: "Samedi",
    date: "29 mai",
    titre: "La grande nuit",
    texte: "Magiciens sur scène et en close-up, concerts toute la journée et grande soirée avec nos têtes d'affiche.",
  },
  {
    jour: "Dimanche",
    date: "30 mai",
    titre: "La journée des familles",
    texte: "Artistes pour les enfants, magie à hauteur d'yeux, jeux et animations pour tous les âges.",
  },
];
---

<Base
  accueil
  titre="Les Ragondins Farfelus · Festival musique et magie, Loiret, mai 2027"
  description="Festival de musique et de magie les 28, 29 et 30 mai 2027 au Domaine de Briquemault (Loiret), à 1 h 30 de Paris : concerts, DJ sets, magiciens, camping."
  donneesStructurees={evenementSchema()}
>
  <!--
    Avant d'afficher quoi que ce soit, on décide si l'on montre l'entrée par le
    miroir : oui à la première arrivée sur le site (pendant la visite, revenir à
    l'accueil depuis une autre page mène directement au site). Sans JavaScript,
    pas de miroir : le site s'affiche directement.
  -->
  <script is:inline slot="tete">
    try {
      if (sessionStorage.getItem("rf-entre") !== "1") document.documentElement.classList.add("avec-miroir");
    } catch (e) {
      document.documentElement.classList.add("avec-miroir");
    }
  </script>

  <!-- ===================== L'ENTRÉE : LE MIROIR DE L'AFFICHE ===================== -->
  <!--
    L'affiche de la graphiste au pixel près, avec seulement le titre dans le miroir.
    États (data-etat) : affiche (on attend le clic) · traversee (vagues, on plonge
    dans le miroir, tout passe au noir) ; ensuite l'entrée disparaît et le site apparaît.
  -->
  <div class="entree" data-etat="affiche">
    <div class="affiche">
      <img class="affiche__sol" src="/brouillon/sol-damier.svg" alt="" width="6660" height="1596" />
      <canvas class="affiche__eau" aria-hidden="true"></canvas>
      <img
        class="affiche__cadre"
        src="/brouillon/cadre-or.webp"
        alt=""
        width="1007"
        height="1292"
        fetchpriority="high"
      />
      <img class="affiche__escalier" src="/brouillon/escalier.webp" alt="" width="419" height="244" />

      <div class="portail">
        <div class="portail__logo">
          <img
            src="/brouillon/logo.webp"
            srcset="/brouillon/logo-petit.webp 564w, /brouillon/logo.webp 1200w"
            sizes="(max-width: 700px) 70vw, 540px"
            alt=""
            width="1200"
            height="717"
            fetchpriority="high"
          />
        </div>
      </div>

      <button class="affiche__miroir" type="button" hidden>
        <span class="sr-only">Entrer dans le site des Ragondins Farfelus</span>
      </button>

      <p class="affiche__indice" hidden aria-hidden="true">
        <span class="indice--doigt">Touchez le miroir pour entrer</span>
        <span class="indice--souris">Cliquez sur le miroir pour entrer</span>
      </p>
    </div>

    <div class="voile-noir" aria-hidden="true"></div>
  </div>

  <!-- ===================== LE HAUT DE L'ACCUEIL (fond noir) ===================== -->
  <section class="haut" aria-labelledby="titre-festival">
    <div class="portail">
      <h1 id="titre-festival" class="portail__logo" tabindex="-1">
        <img
          src="/brouillon/logo.webp"
          srcset="/brouillon/logo-petit.webp 564w, /brouillon/logo.webp 1200w"
          sizes="(max-width: 700px) 80vw, 500px"
          alt="Les Ragondins Farfelus, festival de musique et de magie dans le Loiret"
          width="1200"
          height="717"
        />
      </h1>
      <p class="portail__badge">Festival de musique et de magie</p>
      <div class="portail__infos">
        <p class="portail__lieu">
          Domaine de Briquemault
          <span>45230 Sainte-Geneviève-des-Bois</span>
        </p>
        <p class="portail__dates">
          <span><time datetime="2027-05-28">28</time>-29-<time datetime="2027-05-30">30</time></span>
          <span>mai 2027</span>
        </p>
      </div>
      <p class="portail__genres">Magie · DJ sets · Concerts jazz et rock</p>
      <p class="portail__affiche">Têtes d'affiche dévoilées très bientôt</p>
    </div>

    <div class="haut__actions">
      <a class="bouton bouton--rose" href="/billetterie/">Billetterie</a>
      <a class="bouton bouton--contour" href="/programmation/">Découvrir la programmation</a>
    </div>

    <a class="haut__suite" href="#experience" aria-label="Découvrir le festival">
      <span aria-hidden="true"></span>
    </a>
  </section>

  <!-- ===================== L'EXPÉRIENCE ===================== -->
  <section class="section experience" id="experience" aria-labelledby="titre-experience">
    <div class="contenu">
      <span class="surtitre">Le festival</span>
      <h2 id="titre-experience">Là où la musique rencontre l'illusion</h2>
      <p class="intro">
        <strong>Les Ragondins Farfelus</strong> est un festival de musique et de magie qui se tient les
        28, 29 et 30 mai 2027 au Domaine de Briquemault, à Sainte-Geneviève-des-Bois, dans le Loiret,
        à 1&nbsp;h&nbsp;30 de Paris. Un monde mystérieux, onirique et hors du temps qui s'éveille une
        fois par an&nbsp;: trois jours d'expérience immersive entre nature, musique puissante et magie,
        au profit de l'association Handi'Chiens.
      </p>

      <section class="en-bref" aria-labelledby="titre-en-bref">
        <h3 id="titre-en-bref">Le festival en bref</h3>
        <dl>
          <div><dt>Quoi</dt><dd>Festival de musique (jazz, jazz manouche, rock, pop, DJ sets) et de magie (scène et close-up)</dd></div>
          <div><dt>Quand</dt><dd>Vendredi 28, samedi 29 et dimanche 30 mai 2027 · 2<sup>e</sup> édition</dd></div>
          <div><dt>Où</dt><dd>{festival.lieu.nom}, {festival.lieu.codePostal} {festival.lieu.commune} (Loiret, Centre-Val de Loire)</dd></div>
          <div><dt>À combien</dt><dd>1&nbsp;h&nbsp;30 de Paris, 1&nbsp;h&nbsp;15 d'Orléans, 25&nbsp;min de Montargis et de Gien · <a href="/venir/">Comment venir</a></dd></div>
          <div><dt>Pour qui</dt><dd>Tout public&nbsp;; journée des familles le dimanche&nbsp;; entrée gratuite pour les moins de 11&nbsp;ans et les personnes en situation de handicap</dd></div>
          <div><dt>Dormir</dt><dd>Camping sur place dès le vendredi après-midi</dd></div>
          <div><dt>Pour la bonne cause</dt><dd>Au profit de l'association Handi'Chiens</dd></div>
        </dl>
      </section>

      <ul class="arches">
        {
          univers.map((u) => (
            <li class="arche">
              <span class="arche__icone" aria-hidden="true">
                {u.icone === "musique" && (
                  <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 36V10l20-4v26" />
                    <circle cx="13" cy="36" r="5" />
                    <circle cx="33" cy="32" r="5" />
                  </svg>
                )}
                {u.icone === "magie" && (
                  <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M24 4c1.5 9 4 11.5 13 13-9 1.5-11.5 4-13 13-1.5-9-4-11.5-13-13 9-1.5 11.5-4 13-13Z" />
                    <path d="M38 30c.7 4 1.8 5.2 6 6-4.2.8-5.3 2-6 6-.7-4-1.8-5.2-6-6 4.2-.8 5.3-2 6-6Z" />
                  </svg>
                )}
                {u.icone === "nature" && (
                  <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10 40C10 20 22 8 40 8c0 18-12 30-30 32Z" />
                    <path d="M10 40 30 18" />
                  </svg>
                )}
              </span>
              <h3>{u.titre}</h3>
              <p>{u.texte}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ===================== PROGRAMME ===================== -->
  <section class="section programme" id="programme" aria-labelledby="titre-programme">
    <div class="contenu">
      <span class="surtitre">Programmation</span>
      <h2 id="titre-programme">Trois jours, trois ambiances</h2>
      <p class="intro">Les artistes seront dévoilés au fil des semaines. Restez à l'affût&nbsp;!</p>

      <ol class="jours">
        {
          jours.map((j) => (
            <li class="jour">
              <p class="jour__date">
                <span class="jour__nom">{j.jour}</span>
                <span class="texte-or">{j.date}</span>
              </p>
              <h3>{j.titre}</h3>
              <p>{j.texte}</p>
            </li>
          ))
        }
      </ol>
      <div class="boutons">
        <a class="bouton bouton--contour" href="/programmation/">Toute la programmation</a>
      </div>
    </div>
  </section>

  <!-- ===================== BILLETTERIE ===================== -->
  <section class="section billetterie" aria-labelledby="titre-billetterie">
    <div class="contenu billetterie__carte">
      <div>
        <span class="surtitre">Billetterie</span>
        <h2 id="titre-billetterie">Ouverture prochaine</h2>
        <p>
          Pass jour, pass 3 jours, camping : toutes les formules seront disponibles à l'ouverture de
          la billetterie.
        </p>
        <div class="boutons">
          <a class="bouton bouton--rose" href="/billetterie/">Voir les formules</a>
        </div>
      </div>
      <p class="billetterie__gratuit">
        <strong>Entrée gratuite</strong> pour les moins de 11&nbsp;ans et les personnes en situation
        de handicap.
      </p>
    </div>
  </section>

  <!-- ===================== RETOUR SUR 2026 ===================== -->
  <section class="section retour" aria-labelledby="titre-retour">
    <div class="contenu">
      <div class="titre-section">
        <span class="surtitre">Retour sur 2026</span>
        <h2 id="titre-retour">La première fois que le portail s'est ouvert</h2>
        <p class="intro">
          Les 30 et 31 mai 2026, le Domaine de Briquemault accueillait la toute première édition des
          Ragondins Farfelus. Magie, jazz, rock, guinguette et DJ sets&nbsp;: retour en images.
        </p>
      </div>
      <ul class="retour__photos" aria-label="Photos de l'édition 2026 (à venir)">
        <li><span>Photo à venir</span></li>
        <li><span>Photo à venir</span></li>
        <li><span>Photo à venir</span></li>
        <li><span>Vidéo à venir</span></li>
      </ul>
    </div>
  </section>

  <!-- ===================== SOLIDARITÉ ===================== -->
  <section class="section solidarite" aria-labelledby="titre-solidarite">
    <div class="contenu solidarite__grille">
      <div>
        <span class="surtitre">Un festival solidaire</span>
        <h2 id="titre-solidarite">Au profit de Handi'Chiens</h2>
      </div>
      <div>
        <p class="intro">
          Les Ragondins Farfelus soutiennent l'association Handi'Chiens, qui éduque et remet
          gratuitement des chiens d'assistance à des personnes en situation de handicap.
        </p>
        <p>
          Chaque billet, chaque verre partagé au bar contribue à offrir un compagnon à quatre pattes
          à celles et ceux qui en ont besoin.
        </p>
      </div>
    </div>
  </section>

  <!-- ===================== LE LIEU ===================== -->
  <section class="section lieu" aria-labelledby="titre-lieu">
    <div class="contenu">
      <span class="surtitre">Le lieu</span>
      <h2 id="titre-lieu">Le Domaine de Briquemault</h2>
      <p class="intro">
        Un domaine chargé d'histoire au cœur du Loiret, entre Montargis et Gien, avec ses ruines de
        château fort, son orangerie et sa guinguette, qui ouvre ses portes au festival le temps d'un
        week-end. À 1&nbsp;h&nbsp;30 de Paris et 1&nbsp;h&nbsp;15 d'Orléans.
      </p>

      <dl class="chiffres">
        <div>
          <dt>Hectares de nature</dt>
          <dd class="texte-or">10</dd>
        </div>
        <div>
          <dt>De Paris</dt>
          <dd class="texte-or">1 h 30</dd>
        </div>
        <div>
          <dt>Jours de festival</dt>
          <dd class="texte-or">3</dd>
        </div>
      </dl>

      <div class="boutons">
        <a class="bouton bouton--contour" href="/domaine/">Découvrir le domaine</a>
        <a class="bouton bouton--contour" href="/venir/">Comment venir</a>
      </div>
    </div>
  </section>

  <!-- ===================== REJOINDRE L'AVENTURE ===================== -->
  <section class="rejoindre" aria-labelledby="titre-rejoindre">
    <div class="contenu rejoindre__contenu">
      <div>
        <h2 id="titre-rejoindre">Rejoignez l'aventure</h2>
        <p>
          Bénévoles, entreprises, médias : il y a mille façons de faire partie du monde des
          Ragondins.
        </p>
      </div>
      <div class="rejoindre__boutons">
        <a class="bouton bouton--vert" href="/benevoles/">Devenir bénévole</a>
        <a class="bouton bouton--vert" href="/partenaires/">Devenir partenaire</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { creerEau, type Eau } from "../scripts/miroir-eau";

  const racine = document.documentElement;
  const entree = document.querySelector<HTMLElement>(".entree");
  const affiche = document.querySelector<HTMLElement>(".affiche");
  const cadre = document.querySelector<HTMLImageElement>(".affiche__cadre");
  const miroir = document.querySelector<HTMLButtonElement>(".affiche__miroir");
  const indice = document.querySelector<HTMLElement>(".affiche__indice");
  const canvas = document.querySelector<HTMLCanvasElement>(".affiche__eau");
  const logo = document.querySelector<HTMLImageElement>(".affiche .portail__logo img");
  const voile = document.querySelector<HTMLElement>(".voile-noir");
  const titre = document.querySelector<HTMLElement>("#titre-festival");
  const reduit = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  type Trou = { cx: number; cy: number; l: number; h: number };

  // Tout ce qui est derrière l'entrée est mis de côté (clavier, lecteurs d'écran)
  // tant qu'on n'est pas passé par le miroir
  const derriere = () => [
    ...Array.from(document.querySelectorAll<HTMLElement>("body > *:not(main):not(script)")),
    ...Array.from(document.querySelectorAll<HTMLElement>("main > *:not(.entree)")),
  ];

  // L'ouverture du miroir (le plus grand « trou » du cadre) : masque de l'eau
  // et centre du zoom quand on entre
  async function chargerTrou(): Promise<Trou | null> {
    try {
      const d = (await (await fetch("/brouillon/cadre-or.json")).json()) as { formes: { trous: number[][][] }[] };
      const aire = (p: number[][]) =>
        Math.abs(p.reduce((s, [x, y], i) => s + x * p[(i + 1) % p.length][1] - p[(i + 1) % p.length][0] * y, 0)) / 2;
      let trou: number[][] = [];
      for (const f of d.formes) for (const t of f.trous) if (aire(t) > aire(trou)) trou = t;
      if (trou.length < 3) return null;
      const chemin = "M" + trou.map(([x, y]) => `${(x * 1000).toFixed(1)} ${(y * 1000).toFixed(1)}`).join("L") + "Z";
      const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000" preserveAspectRatio="none"><path d="${chemin}" fill="#fff"/></svg>`;
      affiche!.style.setProperty("--masque", `url("data:image/svg+xml,${encodeURIComponent(svg)}")`);
      const xs = trou.map((p) => p[0]);
      const ys = trou.map((p) => p[1]);
      const [x0, x1, y0, y1] = [Math.min(...xs), Math.max(...xs), Math.min(...ys), Math.max(...ys)];
      return { cx: (x0 + x1) / 2, cy: (y0 + y1) / 2, l: x1 - x0, h: y1 - y0 };
    } catch {
      return null;
    }
  }

  async function demarrer() {
    if (!racine.classList.contains("avec-miroir")) return;
    if (!entree || !affiche || !cadre || !miroir || !canvas || !logo || !voile) {
      racine.classList.remove("avec-miroir");
      return;
    }
    let eau: Eau | null = null;
    let trou: Trou | null = null;
    const caches = derriere();
    caches.forEach((el) => (el.inert = true));
    miroir.hidden = false;
    if (indice) indice.hidden = false;

    // On plonge dans le miroir : vagues, l'affiche grandit autour de
    // l'ouverture, tout passe au noir, puis le site apparaît.
    function plonger(x?: number, y?: number) {
      if (entree!.dataset.etat !== "affiche") return;
      entree!.dataset.etat = "traversee";
      if (eau) {
        if (x !== undefined && y !== undefined) eau.goutte(x, y, 1.8);
        else eau.goutteAuCentre(1.8);
      }
      if (reduit) {
        voile!.style.opacity = "1";
        setTimeout(entrerDansLeSite, 300);
        return;
      }
      const rc = cadre!.getBoundingClientRect();
      const ra = affiche!.getBoundingClientRect();
      const t = trou ?? { cx: 0.5, cy: 0.5, l: 0.9, h: 0.9 };
      const cx = rc.left + rc.width * t.cx;
      const cy = rc.top + rc.height * t.cy;
      const echelleFin = 1.6 * Math.max(window.innerWidth / (rc.width * t.l * 0.8), window.innerHeight / (rc.height * t.h * 0.8));
      affiche!.style.transformOrigin = `${cx - ra.left}px ${cy - ra.top}px`;
      const debut = performance.now();
      const ATTENTE = 220; // le temps de voir les vagues partir
      const DUREE = 900;
      function pas(maintenant: number) {
        const k = Math.min(1, Math.max(0, (maintenant - debut - ATTENTE) / DUREE));
        affiche!.style.transform = `scale(${Math.pow(echelleFin, Math.pow(k, 2))})`;
        voile!.style.opacity = String(Math.min(1, Math.max(0, (k - 0.45) / 0.5)));
        if (k < 1) requestAnimationFrame(pas);
        else entrerDansLeSite();
      }
      requestAnimationFrame(pas);
    }

    // De l'autre côté du miroir : le site, sur fond noir
    function entrerDansLeSite() {
      try {
        sessionStorage.setItem("rf-entre", "1");
      } catch {
        /* navigation privée : sans importance */
      }
      eau?.detruire();
      window.scrollTo(0, 0);
      caches.forEach((el) => (el.inert = false));
      racine.classList.add("vient-d-entrer");
      racine.classList.remove("avec-miroir");
      titre?.focus({ preventScroll: true });
      setTimeout(() => racine.classList.remove("vient-d-entrer"), 2500);
    }

    miroir.addEventListener("click", (e) => {
      // e.detail = 0 : validé au clavier (pas de position)
      if (e.detail === 0) plonger();
      else plonger(e.clientX, e.clientY);
    });

    trou = await chargerTrou();
    if (!reduit && trou) {
      try {
        eau = creerEau({ canvas, logo, affiche, surPret: () => affiche.classList.add("eau-active") });
      } catch (erreur) {
        console.error("L'eau du miroir n'a pas pu s'animer :", erreur);
      }
      if (eau) {
        // Au survol, de petites vagues suivent la souris
        let derniere = 0;
        miroir.addEventListener("pointermove", (e) => {
          if (e.pointerType !== "mouse" || entree.dataset.etat !== "affiche") return;
          const t = performance.now();
          if (t - derniere < 90) return;
          derniere = t;
          eau!.goutte(e.clientX, e.clientY, 0.6);
        });
      }
    }
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", demarrer, { once: true });
  else demarrer();
</script>

<style is:global>
  /* Pendant l'entrée par le miroir, la page ne défile pas */
  html.avec-miroir,
  html.avec-miroir body {
    overflow: hidden;
    overscroll-behavior: none;
  }

  /* Le site apparaît en douceur quand on sort du miroir */
  html.vient-d-entrer .entete {
    animation: rf-apparaitre 1.2s 0.3s ease-out both;
  }

  @keyframes rf-apparaitre {
    from {
      opacity: 0;
    }
  }
</style>

<style>
  /* ---------- L'entrée : plein écran par-dessus le site ---------- */
  .entree {
    --l: min(calc(100vw / 0.86), calc(100svh * 0.685), 900px);
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    align-items: center;
    justify-content: center;
    background: #072223;
    overflow: hidden;
    isolation: isolate;
  }

  :global(html.avec-miroir) .entree {
    display: flex;
  }

  /* ---------- L'affiche de la graphiste et le miroir ---------- */
  /*
    Toutes les positions sont celles de l'affiche (848 × 1200), en % de l'affiche.
    --l : largeur de l'affiche. Sur téléphone, l'affiche déborde un peu à gauche et
    à droite (là où il n'y a que du fond vert) pour que le miroir soit plus grand.
  */
  /*
    Le point de fuite du damier et l'escalier sont à 51,63 % de la largeur de
    l'affiche : on décale légèrement l'affiche pour qu'ils tombent pile au milieu
    de l'écran, et que les carreaux soient bien droits de part et d'autre.
  */
  .affiche {
    position: relative;
    left: calc(var(--l) * -0.0163);
    z-index: 0;
    flex: none;
    width: var(--l);
    aspect-ratio: 848 / 1200;
    container-type: inline-size;
    isolation: isolate;
  }

