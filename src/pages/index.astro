---
import Base from "../layouts/Base.astro";
import { evenementSchema } from "../data/site";

// Textes provisoires : à relire et valider par l'équipe avant la mise en ligne.
const univers = [
  {
    titre: "La musique",
    texte:
      "Jazz, jazz manouche, rock, pop et DJ sets jusqu'au bout de la nuit, sur plusieurs scènes nichées dans le domaine.",
    icone: "musique",
  },
  {
    titre: "La magie",
    texte:
      "De grands numéros d'illusion sur scène et des magiciens qui surgissent au milieu du public, à quelques centimètres de vous.",
    icone: "magie",
  },
  {
    titre: "La nature",
    texte:
      "Dix hectares de nature préservée au bord du Loing, transformés le temps d'un week-end en monde onirique.",
    icone: "nature",
  },
];

const jours = [
  {
    jour: "Vendredi",
    date: "28 mai",
    titre: "L'éveil",
    texte: "Ouverture du camping, premiers concerts en fin d'après-midi, puis DJ sets jusque tard dans la nuit.",
  },
  {
    jour: "Samedi",
    date: "29 mai",
    titre: "La grande nuit",
    texte: "Magiciens sur scène et en close-up, concerts toute la journée et grande soirée avec nos têtes d'affiche.",
  },
  {
    jour: "Dimanche",
    date: "30 mai",
    titre: "La journée des familles",
    texte: "Artistes pour les enfants, magie à hauteur d'yeux, jeux et animations pour tous les âges.",
  },
];
---

<Base
  accueil
  titre="Les Ragondins Farfelus · Festival de musique et de magie · 28-30 mai 2027"
  description="Festival de musique et de magie au Domaine de Briquemault (Loiret), les 28, 29 et 30 mai 2027. Concerts, DJ sets, magiciens. Au profit de Handi'Chiens."
  donneesStructurees={evenementSchema()}
>
  <!-- ===================== OUVERTURE : LE PORTAIL ===================== -->
  <!--
    Trois états (attribut data-etat) :
      statique : visuel 2D (sans JavaScript, animations réduites, ou en attendant la 3D)
      seuil    : le portail en 3D, on invite à entrer
      monde    : on a traversé, le monde s'affiche avec les infos du festival
  -->
  <section class="ouverture" data-etat="statique" aria-labelledby="titre-festival">
    <canvas class="ouverture__monde" aria-hidden="true"></canvas>

    <div class="portail">
      <h1 id="titre-festival" class="portail__logo">
        <img
          src="/brouillon/logo.webp"
          alt="Les Ragondins Farfelus"
          width="1200"
          height="717"
          fetchpriority="high"
        />
      </h1>
      <p class="portail__badge">Festival de musique et de magie</p>
      <div class="portail__infos">
        <p class="portail__lieu">
          Domaine de Briquemault
          <span>Sainte-Geneviève-des-Bois</span>
        </p>
        <p class="portail__dates">
          <span class="texte-or">28·29·30</span>
          <span>mai 2027</span>
        </p>
      </div>
      <p class="portail__genres">Magie · DJ sets · Concerts jazz et rock</p>
      <p class="portail__affiche">Têtes d'affiche dévoilées très bientôt</p>
    </div>

    <div class="scene">
      <img class="scene__escalier" src="/brouillon/escalier.webp" alt="" width="419" height="244" />
      <div class="scene__actions">
        <a class="bouton bouton--rose" href="/billetterie/">Billetterie</a>
        <a class="bouton bouton--contour" href="/programmation/">Découvrir la programmation</a>
      </div>
    </div>

    <div class="seuil" hidden>
      <p class="seuil__invitation">
        Un monde s'éveille une fois par an au cœur du Loiret.<br />
        <strong>Oserez-vous franchir le portail&nbsp;?</strong>
      </p>
      <button class="bouton bouton--rose seuil__entrer" type="button">Entrer dans le monde</button>
      <button class="seuil__passer" type="button">Passer l'introduction</button>
    </div>

    <a class="ouverture__suite" href="#experience" aria-label="Découvrir le festival">
      <span aria-hidden="true"></span>
    </a>
  </section>

  <!-- ===================== L'EXPÉRIENCE ===================== -->
  <section class="section experience" id="experience" aria-labelledby="titre-experience">
    <div class="contenu">
      <span class="surtitre">Le festival</span>
      <h2 id="titre-experience">Là où la musique rencontre l'illusion</h2>
      <p class="intro">
        Un monde mystérieux, onirique et hors du temps qui s'éveille une fois par an au cœur du
        Loiret. Trois jours pour vivre une expérience immersive, entre nature, musique puissante et
        magie.
      </p>

      <ul class="arches">
        {
          univers.map((u) => (
            <li class="arche">
              <span class="arche__icone" aria-hidden="true">
                {u.icone === "musique" && (
                  <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 36V10l20-4v26" />
                    <circle cx="13" cy="36" r="5" />
                    <circle cx="33" cy="32" r="5" />
                  </svg>
                )}
                {u.icone === "magie" && (
                  <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M24 4c1.5 9 4 11.5 13 13-9 1.5-11.5 4-13 13-1.5-9-4-11.5-13-13 9-1.5 11.5-4 13-13Z" />
                    <path d="M38 30c.7 4 1.8 5.2 6 6-4.2.8-5.3 2-6 6-.7-4-1.8-5.2-6-6 4.2-.8 5.3-2 6-6Z" />
                  </svg>
                )}
                {u.icone === "nature" && (
                  <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10 40C10 20 22 8 40 8c0 18-12 30-30 32Z" />
                    <path d="M10 40 30 18" />
                  </svg>
                )}
              </span>
              <h3>{u.titre}</h3>
              <p>{u.texte}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ===================== PROGRAMME ===================== -->
  <section class="section programme" id="programme" aria-labelledby="titre-programme">
    <div class="contenu">
      <span class="surtitre">Programmation</span>
      <h2 id="titre-programme">Trois jours, trois ambiances</h2>
      <p class="intro">Les artistes seront dévoilés au fil des semaines. Restez à l'affût&nbsp;!</p>

      <ol class="jours">
        {
          jours.map((j) => (
            <li class="jour">
              <p class="jour__date">
                <span class="jour__nom">{j.jour}</span>
                <span class="texte-or">{j.date}</span>
              </p>
              <h3>{j.titre}</h3>
              <p>{j.texte}</p>
            </li>
          ))
        }
      </ol>
      <div class="boutons">
        <a class="bouton bouton--contour" href="/programmation/">Toute la programmation</a>
      </div>
    </div>
  </section>

  <!-- ===================== BILLETTERIE ===================== -->
  <section class="section billetterie" aria-labelledby="titre-billetterie">
    <div class="contenu billetterie__carte">
      <div>
        <span class="surtitre">Billetterie</span>
        <h2 id="titre-billetterie">Ouverture prochaine</h2>
        <p>
          Pass jour, pass 3 jours, camping : toutes les formules seront disponibles à l'ouverture de
          la billetterie.
        </p>
        <div class="boutons">
          <a class="bouton bouton--rose" href="/billetterie/">Voir les formules</a>
        </div>
      </div>
      <p class="billetterie__gratuit">
        <strong>Entrée gratuite</strong> pour les moins de 11&nbsp;ans et les personnes en situation
        de handicap.
      </p>
    </div>
  </section>

  <!-- ===================== RETOUR SUR 2026 ===================== -->
  <section class="section retour" aria-labelledby="titre-retour">
    <div class="contenu">
      <div class="titre-section">
        <span class="surtitre">Retour sur 2026</span>
        <h2 id="titre-retour">La première fois que le portail s'est ouvert</h2>
        <p class="intro">
          Les 30 et 31 mai 2026, le Domaine de Briquemault accueillait la toute première édition des
          Ragondins Farfelus. Magie, jazz, rock, guinguette et DJ sets&nbsp;: retour en images.
        </p>
      </div>
      <ul class="retour__photos" aria-label="Photos de l'édition 2026 (à venir)">
        <li><span>Photo à venir</span></li>
        <li><span>Photo à venir</span></li>
        <li><span>Photo à venir</span></li>
        <li><span>Vidéo à venir</span></li>
      </ul>
    </div>
  </section>

  <!-- ===================== SOLIDARITÉ ===================== -->
  <section class="section solidarite" aria-labelledby="titre-solidarite">
    <div class="contenu solidarite__grille">
      <div>
        <span class="surtitre">Un festival solidaire</span>
        <h2 id="titre-solidarite">Au profit de Handi'Chiens</h2>
      </div>
      <div>
        <p class="intro">
          Les Ragondins Farfelus soutiennent l'association Handi'Chiens, qui éduque et remet
          gratuitement des chiens d'assistance à des personnes en situation de handicap.
        </p>
        <p>
          Chaque billet, chaque verre partagé au bar contribue à offrir un compagnon à quatre pattes
          à celles et ceux qui en ont besoin.
        </p>
      </div>
    </div>
  </section>

  <!-- ===================== LE LIEU ===================== -->
  <section class="section lieu" aria-labelledby="titre-lieu">
    <div class="contenu">
      <span class="surtitre">Le lieu</span>
      <h2 id="titre-lieu">Le Domaine de Briquemault</h2>
      <p class="intro">
        Un domaine chargé d'histoire au cœur du Loiret, entre château, orangerie et guinguette,
        qui ouvre ses portes au festival le temps d'un week-end.
      </p>

      <dl class="chiffres">
        <div>
          <dt>Hectares de nature</dt>
          <dd class="texte-or">10</dd>
        </div>
        <div>
          <dt>De Paris</dt>
          <dd class="texte-or">1 h 30</dd>
        </div>
        <div>
          <dt>Jours de festival</dt>
          <dd class="texte-or">3</dd>
        </div>
      </dl>

      <div class="boutons">
        <a class="bouton bouton--contour" href="/domaine/">Découvrir le domaine</a>
        <a class="bouton bouton--contour" href="/infos/#venir">Comment venir</a>
      </div>
    </div>
  </section>

  <!-- ===================== REJOINDRE L'AVENTURE ===================== -->
  <section class="rejoindre" aria-labelledby="titre-rejoindre">
    <div class="contenu rejoindre__contenu">
      <div>
        <h2 id="titre-rejoindre">Rejoignez l'aventure</h2>
        <p>
          Bénévoles, entreprises, médias : il y a mille façons de faire partie du monde des
          Ragondins.
        </p>
      </div>
      <div class="rejoindre__boutons">
        <a class="bouton bouton--vert" href="/benevoles/">Devenir bénévole</a>
        <a class="bouton bouton--vert" href="/partenaires/">Devenir partenaire</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // L'entrée en 3D ne se charge qu'après l'affichage de la page, et seulement si
  // l'appareil le permet. Sinon, le visuel 2D reste en place.
  const ouverture = document.querySelector<HTMLElement>(".ouverture");
  const canvas = document.querySelector<HTMLCanvasElement>(".ouverture__monde");
  const seuil = document.querySelector<HTMLElement>(".seuil");
  const reduit = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function webglDisponible() {
    try {
      const c = document.createElement("canvas");
      return Boolean(c.getContext("webgl2") || c.getContext("webgl"));
    } catch {
      return false;
    }
  }

  function dejaEntre() {
    try {
      return sessionStorage.getItem("rf-entre") === "1";
    } catch {
      return false;
    }
  }

  function memoriserEntree() {
    try {
      sessionStorage.setItem("rf-entre", "1");
    } catch {
      /* navigation privée : sans importance */
    }
  }

  async function lancer() {
    if (!ouverture || !canvas || !seuil) return;
    const { lancerMonde } = await import("../scripts/monde");
    const entre = dejaEntre();
    const monde = await lancerMonde({
      canvas,
      imagePortail: "/brouillon/cadre-or.webp",
      formePortail: "/brouillon/cadre-or.json",
      dossierRessources: "/monde",
      dejaEntre: entre,
      // ?qualite=haute ou ?qualite=basse dans l'adresse force un niveau (pour les tests)
      qualite: new URLSearchParams(location.search).get("qualite") as "haute" | "basse" | null,
      surPret: () => {
        ouverture.dataset.etat = entre ? "monde" : "seuil";
        seuil.hidden = entre;
      },
      surDepart: () => {
        seuil.hidden = true;
      },
      surEntree: () => {
        ouverture.dataset.etat = "monde";
        seuil.hidden = true;
        memoriserEntree();
      },
    });
    seuil.querySelector(".seuil__entrer")?.addEventListener("click", () => monde.entrer());
    seuil.querySelector(".seuil__passer")?.addEventListener("click", () => monde.passer());
  }

  if (!reduit && webglDisponible()) {
    const demarrer = () =>
      lancer().catch((erreur) => {
        console.error("Le monde 3D n'a pas pu se lancer :", erreur);
        ouverture!.dataset.etat = "statique";
      });
    if (document.readyState === "complete") setTimeout(demarrer, 50);
    else window.addEventListener("load", () => setTimeout(demarrer, 50), { once: true });
  }
</script>

<style>
  /* ---------- Ouverture (le portail) ---------- */
  .ouverture {
    --pw: min(88vw, 560px, 58svh);
    position: relative;
    min-height: 100svh;
    padding-top: calc(var(--hauteur-entete) + clamp(1rem, 4svh, 2.5rem));
    display: flex;
    flex-direction: column;
    align-items: center;
    background: radial-gradient(
        ellipse 70% 55% at 50% 38%,
        var(--emeraude) 0%,
        #0b4a48 38%,
        var(--vert) 62%,
        var(--vert-nuit) 100%
      );
    overflow: hidden;
    isolation: isolate;
  }

  .ouverture__monde {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0;
    transition: opacity 1.2s ease;
    touch-action: pan-y;
  }

  .portail {
    position: relative;
    z-index: 2;
    width: var(--pw);
    aspect-ratio: 1007 / 1292;
    max-width: 100%;
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: calc(var(--pw) * 0.032);
    padding: 0 calc(var(--pw) * 0.15);
    text-align: center;
    background: url("/brouillon/cadre-or.webp") center / contain no-repeat;
    filter: drop-shadow(0 0 2.5rem rgba(243, 226, 176, 0.18));
    animation: apparition 1.4s ease-out both;
    transition: opacity 0.8s ease;
  }

  .portail__logo {
    margin: 0;
    width: 100%;
  }

  .portail__logo img {
    width: 100%;
  }

  .portail__badge {
    margin: 0;
    padding: 0.35em 1.1em;
    border: 1.5px solid var(--creme);
    border-radius: 999px;
    font-size: clamp(0.72rem, 3.1cqw, 1rem);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .portail__infos {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 3cqw;
    width: 112%;
  }

  .portail__infos::before {
    content: "";
    grid-column: 2;
    grid-row: 1;
    width: 1.5px;
    height: 100%;
    background: var(--creme);
    opacity: 0.6;
  }

  .portail__lieu,
  .portail__dates {
    margin: 0;
    grid-row: 1;
    line-height: 1.1;
  }

  .portail__lieu {
    grid-column: 1;
    font-size: clamp(0.8rem, 4.1cqw, 1.35rem);
    font-weight: 700;
    text-transform: uppercase;
    text-align: right;
  }

  .portail__lieu span {
    display: block;
    margin-top: 0.4em;
    font-size: 0.62em;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .portail__dates {
    grid-column: 3;
    text-align: left;
    font-weight: 700;
    text-transform: uppercase;
  }

  .portail__dates span:first-child {
    display: block;
    font-size: clamp(1.3rem, 8cqw, 2.7rem);
    letter-spacing: 0.02em;
  }

  .portail__dates span:last-child {
    font-size: clamp(0.85rem, 4.6cqw, 1.5rem);
  }

  .portail__affiche {
    margin: 0;
    font-size: clamp(0.8rem, 3.6cqw, 1.15rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--creme);
  }

  .portail__genres {
    margin: 0;
    text-wrap: balance;
    font-size: clamp(0.72rem, 3.2cqw, 1rem);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--rose);
  }

  /* L'escalier et le sol en damier (version 2D) */
  .scene {
    position: relative;
    z-index: 1;
    width: 100%;
    flex: 1;
    min-height: clamp(12rem, 30svh, 18rem);
    margin-top: calc(var(--pw) * -0.06);
    display: flex;
    flex-direction: column;
    align-items: center;
    background:
      linear-gradient(to bottom, transparent 55%, var(--vert-nuit) 100%),
      url("/brouillon/sol-damier.webp") center top / max(100%, 900px) auto no-repeat;
    transition: opacity 0.8s ease;
  }

  .scene__escalier {
    width: calc(var(--pw) * 0.42);
    margin-top: calc(var(--pw) * -0.005);
    opacity: 0.95;
  }

  .scene__actions {
    position: relative;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1rem;
    padding: 1.5rem var(--marge) 3rem;
  }

  .scene__actions .bouton--contour {
    background: rgba(5, 40, 40, 0.7);
  }

  /* Invitation à entrer (état « seuil ») */
  .seuil {
    position: absolute;
    z-index: 3;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    padding: 2rem var(--marge) calc(2.25rem + env(safe-area-inset-bottom, 0px));
    text-align: center;
    background: linear-gradient(to top, rgba(2, 24, 24, 0.92), rgba(2, 24, 24, 0));
    animation: monter 1s 0.4s ease-out both;
  }

  .seuil[hidden] {
    display: none;
  }

  .seuil__invitation {
    margin: 0;
    max-width: 30rem;
    color: var(--creme-doux);
    font-size: clamp(1rem, 2.4vw, 1.15rem);
  }

  .seuil__invitation strong {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-titre);
    font-size: clamp(1.35rem, 3.6vw, 1.75rem);
    font-weight: 600;
    color: var(--creme);
  }

  .seuil__entrer {
    min-height: 3.4rem;
    padding-inline: 2.2rem;
    font-size: 1.075rem;
    box-shadow: 0 0 2.5rem rgba(255, 160, 203, 0.35);
  }

  .seuil__passer {
    background: none;
    border: 0;
    padding: 0.5rem 1rem;
    color: var(--creme-doux);
    font: inherit;
    font-size: 0.9rem;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    cursor: pointer;
  }

  .seuil__passer:hover {
    color: var(--rose);
  }

  .ouverture__suite {
    display: none;
  }

  /* ----- État « seuil » : seul le portail 3D est visible ----- */
  .ouverture[data-etat="seuil"] .ouverture__monde,
  .ouverture[data-etat="monde"] .ouverture__monde {
    opacity: 1;
  }

  .ouverture[data-etat="seuil"] .portail,
  .ouverture[data-etat="seuil"] .scene {
    opacity: 0;
    pointer-events: none;
  }

  /* ----- État « monde » : les infos s'affichent par-dessus le monde ----- */
  /* Comme sur l'affiche de la graphiste : les infos au centre, par-dessus le monde */
  .ouverture[data-etat="monde"] {
    justify-content: center;
    padding-bottom: 4rem;
  }

  .ouverture[data-etat="monde"] .portail {
    background: radial-gradient(ellipse at center, rgba(10, 4, 24, 0.55) 0%, rgba(10, 4, 24, 0) 68%);
    filter: none;
    aspect-ratio: auto;
    width: min(92vw, 640px);
    padding: 2.5rem calc(var(--pw) * 0.1);
    animation: apparition 1.6s ease-out both;
  }

  .ouverture[data-etat="monde"] .portail__logo {
    filter: drop-shadow(0 0.4rem 1.6rem rgba(0, 0, 0, 0.55));
  }

  .ouverture[data-etat="monde"] .scene {
    flex: none;
    min-height: 0;
    margin: 0;
    background: none;
  }

  .ouverture[data-etat="monde"] .scene__escalier {
    display: none;
  }

  .ouverture[data-etat="monde"] .scene__actions {
    padding-top: 0.5rem;
    animation: monter 1s 0.6s ease-out both;
  }

  .ouverture[data-etat="monde"] .ouverture__suite {
    display: block;
    position: absolute;
    z-index: 3;
    bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
    left: 50%;
    width: 2.75rem;
    height: 2.75rem;
    margin-left: -1.375rem;
    border-radius: 50%;
    border: 1.5px solid rgba(243, 226, 176, 0.6);
    animation: flotter 2.4s ease-in-out infinite;
  }

  .ouverture__suite span {
    position: absolute;
    left: 50%;
    top: 42%;
    width: 0.7rem;
    height: 0.7rem;
    border-right: 2px solid var(--creme);
    border-bottom: 2px solid var(--creme);
    transform: translate(-50%, -50%) rotate(45deg);
  }

  @keyframes apparition {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  @keyframes monter {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  @keyframes flotter {
    50% {
