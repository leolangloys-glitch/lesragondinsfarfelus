---
import Base from "../layouts/Base.astro";
import EnTetePage from "../components/EnTetePage.astro";
import { habitants, photoAccueil, urlsLicences } from "../data/photos";
---

<Base
  titre="Mentions légales"
  description="Mentions légales du site du festival Les Ragondins Farfelus."
>
  <EnTetePage surtitre="Informations légales" titre="Mentions légales" />

  <section class="section fond-nuit">
    <div class="contenu texte-long">
      <h2>Éditeur du site</h2>
      <p>
        Nom de la structure organisatrice&nbsp;: <em class="a-completer">à compléter</em><br />
        Forme juridique&nbsp;: <em class="a-completer">à compléter</em><br />
        Adresse du siège&nbsp;: <em class="a-completer">à compléter</em><br />
        Numéro SIRET ou RNA&nbsp;: <em class="a-completer">à compléter</em><br />
        Contact&nbsp;: <em class="a-completer">adresse e-mail à compléter</em>
      </p>

      <h2>Directeur ou directrice de la publication</h2>
      <p><em class="a-completer">Nom à compléter</em></p>

      <h2>Hébergement</h2>
      <p>
        Le site est hébergé par GitHub, Inc. (service GitHub Pages), 88 Colin P. Kelly Jr. Street,
        San Francisco, CA 94107, États-Unis.<br />
        Le nom de domaine est enregistré auprès d'OVH SAS, 2 rue Kellermann, 59100 Roubaix, France.
      </p>

      <h2>Propriété intellectuelle</h2>
      <p>
        L'ensemble des contenus de ce site (textes, logos, illustrations, photographies, vidéos) est
        protégé par le droit d'auteur. Toute reproduction sans autorisation préalable est interdite.
      </p>
      <p>
        Identité visuelle et illustrations&nbsp;: <em class="a-completer">nom de la graphiste à compléter</em><br />
        Photographies&nbsp;: voir les crédits ci-dessous.
      </p>

      <h2>Crédits photos</h2>
      <p>
        Les photos de nature sont issues de Wikimedia Commons, sous licence libre. Leurs couleurs et
        leur cadrage ont été modifiés pour le site ; les versions modifiées sont diffusées sous la
        même licence.
      </p>
      <ul class="liste">
        <li>
          Ragondin (page d'accueil)&nbsp;: <a href={photoAccueil.credit.source} rel="noopener">{photoAccueil.credit.auteur}</a>,
          <a href={urlsLicences[photoAccueil.credit.licence]} rel="noopener license">{photoAccueil.credit.licence}</a>
        </li>
        {
          habitants.map((h) => (
            <li>
              {h.nom.replace(/^(Le |La |L')/, "")}&nbsp;: <a href={h.credit.source} rel="noopener">{h.credit.auteur}</a>,{" "}
              <a href={urlsLicences[h.credit.licence]} rel="noopener license">{h.credit.licence}</a>
            </li>
          ))
        }
      </ul>

      <h2>Données personnelles</h2>
      <p>
        Pour savoir comment vos données sont utilisées et comment exercer vos droits, consultez notre&#32;
        <a href="/confidentialite/">politique de confidentialité</a>.
      </p>
    </div>
  </section>
</Base>
