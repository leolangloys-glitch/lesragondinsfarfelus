---
import "@fontsource-variable/outfit";
import "@fontsource-variable/fraunces/full.css";
import "../styles/global.css";
import Entete from "../components/Entete.astro";
import PiedDePage from "../components/PiedDePage.astro";

interface Props {
  titre?: string;
  description?: string;
}

const {
  titre = "Les Ragondins Farfelus — Festival de musique et de magie",
  description = "Festival de musique et de magie au Domaine de Briquemault (Loiret), les 28, 29 et 30 mai 2027. Au profit de l'association Handi'Chiens.",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#083d3d" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
  </head>
  <body>
    <a class="lien-evitement" href="#contenu">Aller au contenu</a>
    <Entete />
    <main id="contenu">
      <slot />
    </main>
    <PiedDePage />
  </body>
</html>
